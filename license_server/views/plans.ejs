<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Plans — License Manager</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
</head>
<body>
<%- include('partials/topbar', { activePage: 'plans' }) %>
<div class="page page-md">

  <% if (typeof flash !== 'undefined' && flash) { %>
  <div class="alert alert-<%= flash.type %>">
    <% if (flash.type === 'success') { %>✅<% } else { %>⚠️<% } %>
    <span><%= flash.msg %></span>
    <button class="alert-close" onclick="this.parentElement.remove()">×</button>
  </div>
  <% } %>

  <div class="page-head">
    <div>
      <div class="page-eyebrow">Templates</div>
      <h1 class="page-title">License Plans</h1>
      <p class="page-sub">Tạo plan mẫu để cấp license nhanh khi thêm machine mới.</p>
    </div>
  </div>

  <div class="card">
    <div class="card-title mb-3">➕ Tạo plan mới</div>
    <form method="POST" action="/plans/add">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
        <div class="form-group">
          <label class="form-label">Tên plan <span class="text-danger">*</span></label>
          <input name="name" class="form-input" placeholder="VD: Gói VIP 6 tháng" required>
        </div>
        <div class="form-group">
          <label class="form-label">Tier</label>
          <select name="tier" class="form-select">
            <option value="trial">Trial</option>
            <option value="basic">Basic</option>
            <option value="pro">Pro</option>
            <option value="unlimited">Unlimited</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Max Players</label>
          <input name="max_players" type="number" value="10" min="1" max="9999" class="form-input">
        </div>
        <div class="form-group">
          <label class="form-label">Ngày hết hạn (từ lúc cấp)</label>
          <input name="expires_days" type="number" value="30" min="0" max="3650" class="form-input">
          <div class="form-hint">0 = không hết hạn</div>
        </div>
        <div class="form-group">
          <label class="form-label">Trial days</label>
          <input name="trial_days" type="number" value="0" min="0" max="365" class="form-input">
        </div>
        <div class="form-group">
          <label class="form-label">Ghi chú</label>
          <input name="note" class="form-input" placeholder="Mô tả plan">
        </div>
      </div>
      <button type="submit" class="btn btn-primary mt-3">✅ Tạo plan</button>
    </form>
  </div>

  <div class="card" style="padding:0;overflow:hidden">
    <div class="card-header" style="padding:16px 20px">
      <div class="card-title" style="margin:0">📋 Danh sách plans</div>
      <div class="card-sub"><%= plans.length %> plans</div>
    </div>
    <% if (plans.length === 0) { %>
    <div class="empty"><i>📋</i><p>Chưa có plan nào</p></div>
    <% } else { %>
    <div class="table-wrap" style="border:none;border-radius:0">
    <table>
      <thead><tr><th>Tên</th><th>Tier</th><th>Max</th><th>Trial Days</th><th>Hạn (ngày)</th><th>Note</th><th>Action</th></tr></thead>
      <tbody>
        <% plans.forEach(function(p) { var td = TIERS[p.tier] || TIERS.basic; %>
        <tr>
          <td><strong><%= p.name %></strong></td>
          <td><span class="tier-badge" style="background:<%= td.bg %>;color:<%= td.color %>"><%= td.label %></span></td>
          <td><%= p.max_players %></td>
          <td><%= p.trial_days || '—' %></td>
          <td><%= p.expires_days || '—' %></td>
          <td class="text-sm text-muted"><%= p.note || '—' %></td>
          <td>
            <form method="POST" action="/plans/delete" style="display:inline" onsubmit="return confirm('Xóa plan <%= p.name %>?')">
              <input type="hidden" name="id" value="<%= p.id %>">
              <button type="submit" class="btn btn-danger btn-xs">🗑</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    </div>
    <% } %>
  </div>
</div>
</body>
</html>
