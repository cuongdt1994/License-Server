<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Operations — License Manager</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
</head>
<body>
<%- include('partials/topbar', { activePage: 'operations' }) %>
<div class="page">

  <% if (typeof flash !== 'undefined' && flash) { %>
  <div class="alert alert-<%= flash.type %>">
    <% if (flash.type === 'success') { %>✅<% } else { %>⚠️<% } %>
    <span><%= flash.msg %></span>
    <button class="alert-close" onclick="this.parentElement.remove()">×</button>
  </div>
  <% } %>

  <div class="page-head">
    <div>
      <div class="page-eyebrow">Runtime operations</div>
      <h1 class="page-title">Trung tâm vận hành</h1>
      <p class="page-sub">PM2, sức khỏe tiến trình, backup và Git deploy.</p>
    </div>
    <div class="flex gap-2 flex-wrap">
      <form method="POST" action="/operations/update" onsubmit="return confirm('Cập nhật code từ Git và restart PM2?')" style="display:inline">
        <button class="btn btn-primary btn-sm" <%= deployStatus && deployStatus.running ? 'disabled' : '' %>>📥 Git Pull + Restart</button>
      </form>
      <form method="POST" action="/operations/check-update" style="display:inline">
        <button class="btn btn-outline btn-sm" <%= deployStatus && deployStatus.running ? 'disabled' : '' %>>🔍 Check Update</button>
      </form>
      <form method="POST" action="/operations/restart" onsubmit="return confirm('Restart PM2 mà không git pull?')" style="display:inline">
        <button class="btn btn-outline btn-sm" <%= deployStatus && deployStatus.running ? 'disabled' : '' %>>🔄 Restart PM2</button>
      </form>
      <form method="POST" action="/operations/rollback" onsubmit="return confirm('Rollback về commit trước?')" style="display:inline">
        <button class="btn btn-outline btn-sm" <%= deployStatus && deployStatus.running ? 'disabled' : '' %>>⏪ Rollback</button>
      </form>
      <a href="/health" target="_blank" class="btn btn-outline btn-sm">💚 Health</a>
    </div>
  </div>

  <!-- Status grid -->
  <div class="stat-grid" style="grid-template-columns:repeat(4,1fr)">
    <div class="stat-card" style="--accent:#22c55e">
      <div class="stat-label">PM2</div>
      <div class="stat-value text-sm" style="font-size:.9rem">
        <% if (runtime.pm2 && runtime.pm2.enabled) { %><span class="badge badge-success">Online</span>
        <% } else { %><span class="badge badge-muted">Not PM2</span><% } %>
      </div>
      <div class="stat-sub"><%= runtime.pm2 && runtime.pm2.name ? runtime.pm2.name : 'npm run pm2:start' %></div>
    </div>
    <div class="stat-card" style="--accent:#6366f1">
      <div class="stat-label">Process Uptime</div>
      <div class="stat-value" style="font-size:1.5rem"><%= Math.floor(processInfo.uptime / 60) %>m</div>
      <div class="stat-sub">PID <code><%= processInfo.pid %></code> · <%= processInfo.node %></div>
    </div>
    <div class="stat-card" style="--accent:#f59e0b">
      <div class="stat-label">Memory</div>
      <div class="stat-value" style="font-size:1.5rem"><%= processInfo.rssMb %> MB</div>
      <div class="stat-sub">Heap: <%= processInfo.heapUsedMb %> MB</div>
    </div>
    <div class="stat-card" style="--accent:#8b5cf6">
      <div class="stat-label">Backups</div>
      <div class="stat-value" style="font-size:1.5rem"><%= backupInfo.count %></div>
      <div class="stat-sub">Mới nhất: <%= backupInfo.latest || '—' %></div>
    </div>
  </div>

  <!-- Endpoints -->
  <div class="section">
    <div class="section-title">📡 Endpoints</div>
    <div class="stat-grid" style="grid-template-columns:repeat(2,1fr)">
      <div class="stat-card" style="--accent:#6366f1"><div class="stat-label">Web UI</div><div class="stat-value text-sm font-mono" style="font-size:.85rem"><%= webUrl %></div></div>
      <div class="stat-card" style="--accent:#22c55e"><div class="stat-label">🔒 TLS License</div><div class="stat-value text-sm font-mono" style="font-size:.85rem"><%= tlsAddress %></div></div>
      <div class="stat-card" style="--accent:#f59e0b"><div class="stat-label">Data Dir</div><div class="stat-value text-sm font-mono" style="font-size:.78rem"><%= dataDir %></div><div class="stat-sub">Source: <%= dataDirSource %></div></div>
      <div class="stat-card" style="--accent:#8b5cf6"><div class="stat-label">Backup Dir</div><div class="stat-value text-sm font-mono" style="font-size:.78rem"><%= backupInfo.dir %></div></div>
    </div>
  </div>

  <!-- Host info -->
  <div class="section">
    <div class="section-title">🖥 Host</div>
    <div class="stat-grid" style="grid-template-columns:repeat(2,1fr)">
      <div class="stat-card" style="--accent:#6366f1"><div class="stat-label">Platform</div><div class="stat-value text-sm" style="font-size:.9rem"><code><%= processInfo.platform %></code></div></div>
      <div class="stat-card" style="--accent:#22c55e"><div class="stat-label">Environment</div><div class="stat-value text-sm" style="font-size:.9rem"><code><%= runtime.nodeEnv %></code></div></div>
    </div>
  </div>

  <!-- Git Deploy -->
  <div class="section">
    <div class="section-title">📥 Git Deploy</div>
    <% if (deployStatus && deployStatus.running) { %>
      <div class="alert alert-info">🔄 Đang chạy tiến trình deploy, vui lòng chờ...</div>
    <% } else if (deployStatus && deployStatus.last) { %>
      <div class="<%= deployStatus.last.ok ? 'alert alert-success' : 'alert alert-danger' %>">
        <%= deployStatus.last.ok ? '✅' : '❌' %>
        <span>Lần cuối: <%= deployStatus.last.ok ? 'Thành công' : 'Có lỗi' %> — <%= new Date(deployStatus.last.finishedAt || deployStatus.last.startedAt).toLocaleString('vi-VN') %></span>
      </div>
      <% if (deployStatus.last.beforeCommit || deployStatus.last.afterCommit) { %>
      <div class="stat-grid" style="grid-template-columns:repeat(2,1fr)">
        <div class="stat-card" style="--accent:#f59e0b"><div class="stat-label">Commit trước</div><div class="stat-value text-sm font-mono" style="font-size:.78rem"><%= deployStatus.last.beforeCommit || 'n/a' %></div></div>
        <div class="stat-card" style="--accent:#22c55e"><div class="stat-label">Commit sau</div><div class="stat-value text-sm font-mono" style="font-size:.78rem"><%= deployStatus.last.afterCommit || 'n/a' %></div><div class="stat-sub"><%= deployStatus.last.gitSummary || '' %></div></div>
      </div>
      <% } %>
      <% if (deployStatus.last.steps && deployStatus.last.steps.length) { %>
        <div style="display:grid;gap:8px;margin-top:12px">
        <% deployStatus.last.steps.forEach(function(step) { %>
          <div style="background:var(--panel);border:1px solid var(--border);border-radius:var(--radius-sm);padding:12px">
            <div class="flex items-center justify-between mb-2"><strong class="text-sm"><%= step.name %></strong><span class="badge <%= step.code===0?'badge-success':'badge-danger' %>">exit <%= step.code %></span></div>
            <div class="text-xs text-muted mb-2"><code><%= step.command %></code></div>
            <% if (step.stdout || step.stderr) { %><pre style="background:#0f1723;border:1px solid var(--border);border-radius:6px;padding:10px;max-height:150px;overflow:auto;white-space:pre-wrap;color:#d1d5db;font-size:.74rem;margin:0"><%= (step.stdout||step.stderr).slice(-4000) %></pre><% } %>
          </div>
        <% }) %>
        </div>
      <% } %>
    <% } else { %>
      <p class="text-sm text-muted">Chưa có lịch sử deploy. Nhấn "Git Pull + Restart" để cập nhật lần đầu.</p>
    <% } %>
    <% if (deployStatus && deployStatus.history && deployStatus.history.length) { %>
    <div class="divider"><span>Lịch sử deploy (10 gần nhất)</span></div>
    <div style="display:grid;gap:6px">
    <% deployStatus.history.slice(0,10).forEach(function(item) { %>
      <div style="background:var(--panel);border:1px solid var(--border);border-radius:var(--radius-sm);padding:10px 12px;display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap">
        <div>
          <strong class="text-sm"><%= item.type==='rollback'?'Rollback':item.type==='restart'?'Restart':'Git Update' %></strong>
          <% if (item.beforeCommit) { %><span class="text-xs text-muted"> · <code><%= item.beforeCommit.slice(0,7) %></code> → <code><%= (item.afterCommit||'').slice(0,7) %></code></span><% } %>
        </div>
        <span class="badge <%= item.ok?'badge-success':'badge-danger' %>"><%= item.ok?'OK':'Lỗi' %></span>
      </div>
    <% }) %>
    </div>
    <% } %>
  </div>
</div>
</body>
</html>
