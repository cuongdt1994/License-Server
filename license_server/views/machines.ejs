<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Machines — License Manager</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
  <style>
    .num-input { width: 78px; background: var(--panel); color: var(--text); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 5px 8px; font-size: .85rem; outline: none; }
    .num-input:focus { border-color: var(--primary); }
    .action-row { display: flex; gap: 4px; align-items: center; flex-wrap: wrap; }
    .icon-btn { width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; border: 1px solid transparent; border-radius: 6px; cursor: pointer; font-size: .84rem; transition: all .15s; text-decoration: none; }
    .icon-btn:hover { transform: translateY(-1px); }
    .icon-btn-primary { background: var(--primary); color: #fff; }
    .icon-btn-info { background: #0c4a6e; color: #bae6fd; }
    .icon-btn-purple { background: #4c1d95; color: #ddd6fe; }
    .icon-btn-muted { background: #334155; color: #cbd5e1; }
    .icon-btn-success { background: #14532d; color: #bbf7d0; }
    .icon-btn-danger { background: #7f1d1d; color: #fca5a5; }
    .bulk-bar { display: none; align-items: center; gap: 10px; padding: 10px 16px; background: #1a1f3a; border-bottom: 1px solid var(--border); flex-wrap: wrap; }
    .bulk-bar.visible { display: flex; }
    .bulk-count { color: var(--primary); font-weight: 700; font-size: .85rem; white-space: nowrap; }
    .bulk-btn { padding: 6px 13px; border: none; border-radius: 6px; font-size: .78rem; font-weight: 600; cursor: pointer; color: #fff; transition: opacity .15s; white-space: nowrap; font-family: inherit; }
    .bulk-btn:hover { opacity: .85; }
    .bulk-select { width: 18px; height: 18px; accent-color: var(--primary); cursor: pointer; }
    .tier-opt { border: 2px solid var(--border); border-radius: var(--radius-sm); padding: 10px 14px; cursor: pointer; transition: all .15s; }
    .tier-opt:hover { border-color: var(--primary); }
    .tier-opt.selected { border-color: var(--primary); background: rgba(99,102,241,.08); }
    .tier-label { font-size: .85rem; font-weight: 600; }
    .tier-sub { font-size: .72rem; color: var(--muted); margin-top: 2px; }
    th.sortable { cursor: pointer; user-select: none; position: relative; padding-right: 24px !important; }
    th.sortable:hover { color: #fff; }
    th.sortable.sorted { color: var(--primary); }
    .sort-arrow { position: absolute; right: 6px; font-size: .65rem; opacity: .4; }
    th.sortable.sorted .sort-arrow { opacity: 1; }
    .copy-key-btn { background: none; border: 1px solid var(--border); border-radius: 4px; cursor: pointer; font-size: .7rem; padding: 1px 4px; opacity: .5; transition: all .15s; line-height: 1; }
    .copy-key-btn:hover { opacity: 1; border-color: var(--primary); background: rgba(99,102,241,.1); }
    .copy-key-btn.copied { opacity: 1; border-color: #22c55e; background: rgba(34,197,94,.15); }
  </style>
</head>
<body>

<%- include('partials/topbar', { activePage: 'machines' }) %>

<div class="page">

  <% if (typeof flash !== 'undefined' && flash) { %>
  <div class="alert alert-<%= flash.type %>">
    <% if (flash.type === 'success') { %>✅<% } else { %>⚠️<% } %>
    <span style="white-space:pre-line"><%= flash.msg %></span>
    <button class="alert-close" onclick="this.parentElement.remove()">×</button>
  </div>
  <% } %>

  <%
    var machineRows = Array.isArray(rows) ? rows : [];
    var totalMachines = machineRows.length;
    var onlineMachines = machineRows.filter(function(r) { return r.isOnline && !r.revoked && !r.expired; }).length;
    var expiringSoon = machineRows.filter(function(r) { return r.expiry && !r.expired && Number(r.expiry.daysLeft) <= 3; }).length;
    var revokedMachines = machineRows.filter(function(r) { return r.revoked; }).length;
  %>

  <!-- Hero -->
  <div class="card">
    <div class="flex items-center justify-between flex-wrap gap-3">
      <div>
        <div class="page-eyebrow">License management</div>
        <h1 class="page-title" style="margin:0">Quản lý license theo machine</h1>
        <p class="page-sub">Theo dõi trạng thái, hạn dùng, license key, IP lock.</p>
      </div>
      <div class="flex gap-2">
        <a href="/plans" class="btn btn-outline btn-sm">📋 Plans</a>
        <a href="/import" class="btn btn-outline btn-sm">📤 Import</a>
        <button class="btn btn-primary" data-modal-open="addOverlay">➕ Cấp license mới</button>
      </div>
    </div>
  </div>

  <!-- Metrics -->
  <div class="stat-grid" style="grid-template-columns: repeat(4, 1fr)">
    <div class="stat-card" style="--accent:#6366f1">
      <div class="stat-label">Tổng machine</div>
      <div class="stat-value"><%= totalMachines %></div>
      <div class="stat-sub">Trong whitelist</div>
    </div>
    <div class="stat-card" style="--accent:#22c55e">
      <div class="stat-label">Online</div>
      <div class="stat-value"><%= onlineMachines %></div>
      <div class="stat-sub">Heartbeat hoạt động</div>
    </div>
    <div class="stat-card" style="--accent:#f59e0b">
      <div class="stat-label">Sắp hết hạn</div>
      <div class="stat-value"><%= expiringSoon %></div>
      <div class="stat-sub">≤ 3 ngày</div>
    </div>
    <div class="stat-card" style="--accent:#ef4444">
      <div class="stat-label">Revoked</div>
      <div class="stat-value"><%= revokedMachines %></div>
      <div class="stat-sub">Đã thu hồi</div>
    </div>
  </div>

  <!-- Table -->
  <div class="card" style="padding:0;overflow:hidden">
    <div class="flex items-center justify-between gap-3" style="padding:14px 16px;border-bottom:1px solid var(--border)">
      <div class="card-title" style="margin:0">🖥 Danh sách license</div>
      <div class="text-xs text-muted"><%= totalMachines %> machine</div>
    </div>

    <% if (rows.length === 0) { %>
    <div class="empty"><i>🖥️</i><p>Chưa có máy nào được cấp phép</p></div>
    <% } else { %>

    <!-- Filters -->
    <div class="filter-bar" style="grid-template-columns:1fr 150px 140px auto">
      <input id="machineSearch" class="filter-input" type="search" placeholder="Tìm machine, ghi chú, key, IP...">
      <select id="machineStatusFilter" class="filter-select">
        <option value="">Tất cả trạng thái</option>
        <option value="online">Online</option>
        <option value="offline">Offline</option>
        <option value="expired">Expired</option>
        <option value="revoked">Revoked</option>
        <option value="zombie">Zombie</option>
      </select>
      <select id="machineTierFilter" class="filter-select">
        <option value="">Tất cả tier</option>
        <option value="trial">Trial</option>
        <option value="basic">Basic</option>
        <option value="pro">Pro</option>
        <option value="unlimited">Unlimited</option>
      </select>
      <div class="filter-count"><span id="machineVisibleCount"><%= rows.length %></span>/<%= rows.length %> hiển thị</div>
    </div>

    <!-- Bulk bar -->
    <div class="bulk-bar" id="bulkBar">
      <div class="bulk-count"><span id="bulkSelectedCount">0</span> đã chọn</div>
      <form method="POST" action="/bulk-revoke" id="bulkRevokeForm" onsubmit="return confirmBulk('revoke')" style="display:inline">
        <input type="hidden" name="mids" id="bulkRevokeMids">
        <button type="submit" class="bulk-btn" style="background:#991b1b">🚫 Revoke</button>
      </form>
      <button type="button" class="bulk-btn" style="background:#0e7490" onclick="openBulkRenew()">📅 Gia hạn</button>
      <form method="POST" action="/bulk-delete" id="bulkDeleteForm" onsubmit="return confirmBulk('delete')" style="display:inline">
        <input type="hidden" name="mids" id="bulkDeleteMids">
        <button type="submit" class="bulk-btn" style="background:#7f1d1d">🗑 Xóa</button>
      </form>
      <select id="bulkTierSelect" class="filter-select" style="width:auto" onchange="submitBulkTier(this.value)">
        <option value="">Đổi tier →</option>
        <option value="trial">Trial</option>
        <option value="basic">Basic</option>
        <option value="pro">Pro</option>
        <option value="unlimited">Unlimited</option>
      </select>
      <button type="button" class="bulk-btn" style="background:#475569" onclick="clearBulkSelection()">✕ Bỏ chọn</button>
    </div>

    <div class="table-wrap" style="border:none;border-radius:0">
    <table>
      <thead>
        <tr>
          <th style="width:30px"><input type="checkbox" class="bulk-select" id="selectAllCheckbox" title="Chọn tất cả"></th>
          <th class="sortable" data-sort="mid">Machine ID <span class="sort-arrow">↕</span></th>
          <th class="sortable" data-sort="tier">Tier <span class="sort-arrow">↕</span></th>
          <th class="sortable" data-sort="max">Max <span class="sort-arrow">↕</span></th>
          <th class="sortable" data-sort="peak">Peak <span class="sort-arrow">↕</span></th>
          <th class="sortable" data-sort="status">Status <span class="sort-arrow">↕</span></th>
          <th class="sortable" data-sort="expiry">Expiry <span class="sort-arrow">↕</span></th>
          <th class="sortable" data-sort="note">Note <span class="sort-arrow">↕</span></th>
          <th class="sortable" data-sort="added">Added <span class="sort-arrow">↕</span></th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(function(row) {
          var tier = row.tier || 'basic';
          var td = TIERS[tier] || TIERS.basic;
          var rowStatus = row.revoked ? 'revoked' : row.expired ? 'expired' : row.zombie ? 'zombie' : row.isOnline ? 'online' : 'offline';
          var searchText = [row.mid, tier, row.note, row.license_key, Array.isArray(row.allowed_ips) ? row.allowed_ips.join(' ') : '', rowStatus].filter(Boolean).join(' ').toLowerCase();
        %>
        <tr data-machine-row data-search="<%= searchText %>" data-status="<%= rowStatus %>" data-tier="<%= tier %>"
            data-sort-mid="<%= row.mid.toLowerCase() %>" data-sort-tier="<%= tier %>"
            data-sort-max="<%= row.max_players || 0 %>" data-sort-peak="<%= row.peak_players || 0 %>"
            data-sort-status="<%= rowStatus %>" data-sort-expiry="<%= row.expiry ? row.expiry.daysLeft : 9999 %>"
            data-sort-note="<%= (row.note || '').toLowerCase() %>" data-sort-added="<%= row.added || '' %>">
          <td style="text-align:center"><input type="checkbox" class="bulk-select row-checkbox" data-mid="<%= row.mid %>"></td>
          <td>
            <code><%= row.mid %></code>
            <% if (row.auto) { %><span class="badge badge-muted" style="font-size:.65rem;margin-left:3px">Auto</span><% } %>
            <% if (row.license_key) { %>
              <div class="text-xs text-muted mt-2 font-mono" style="display:flex;align-items:center;gap:4px">
                🔑 <%= row.license_key.slice(0,8) %>…<%= row.license_key.slice(-4) %>
                <button type="button" class="copy-key-btn" onclick="copyLicenseKey(this)" data-key="<%= row.license_key %>" title="Sao chép license key" aria-label="Copy license key">📋</button>
              </div>
            <% } %>
            <% if (Array.isArray(row.allowed_ips) && row.allowed_ips.length) { %>
              <div class="text-xs text-warning mt-2">🛡 IP locked (<%= row.allowed_ips.length %>)</div>
            <% } %>
          </td>
          <td><span class="tier-badge" style="background:<%= td.bg %>;color:<%= td.color %>"><%= td.label %></span></td>
          <td>
            <form method="POST" action="/update-limit" class="flex gap-1 items-center">
              <input type="hidden" name="mid" value="<%= row.mid %>">
              <input type="number" name="max_players" value="<%= row.max_players %>" min="1" max="9999" class="num-input">
              <button type="submit" class="btn btn-primary btn-xs">✓</button>
            </form>
          </td>
          <td class="text-warning" style="font-weight:700"><%= row.peak_players || 0 %></td>
          <td>
            <% if (row.revoked) { %><span class="badge badge-danger">Revoked</span>
            <% } else if (row.expired) { %><span class="badge badge-danger">Expired</span>
            <% } else if (row.zombie) { %><span class="badge badge-warning">Zombie</span>
            <% } else if (row.isOnline) { %>
              <span class="badge badge-success"><span class="status-dot online"></span>Online</span>
              <div class="text-xs text-muted mt-2"><%= row.currentPlayers %>/<%= row.max_players %> players</div>
              <% if (row.pending_cfg) { %><div class="badge badge-warning mt-2" style="font-size:.65rem">⏳ pending</div><% } %>
            <% } else { %><span class="badge badge-muted">Offline</span><% } %>
          </td>
          <td>
            <% if (row.expiry) {
              if (row.expired) { %><span class="text-danger text-xs">❌ Hết hạn <%= row.expiry.date %></span><% }
              else if (row.expiry.daysLeft <= 3) { %><span class="text-warning text-xs">⚠️ <%= row.expiry.daysLeft %>d còn lại</span><% }
              else { %><span class="text-success text-xs">✅ <%= row.expiry.daysLeft %>d — <%= row.expiry.date %></span><% }
            } else { %><span class="text-muted text-xs">—</span><% } %>
          </td>
          <td class="text-sm text-muted truncate" title="<%= row.note||'' %>"><%= row.note || '—' %></td>
          <td class="text-xs text-muted"><%= row.added %></td>
          <td>
            <div class="action-row">
              <% if (!row.revoked) { %>
                <button type="button" class="icon-btn icon-btn-info" title="Gia hạn" data-machine-action="renew" data-mid="<%= row.mid %>" aria-label="Gia hạn">📅</button>
                <button type="button" class="icon-btn icon-btn-purple" title="License key" data-machine-action="key" data-mid="<%= row.mid %>" data-license-key="<%= row.license_key || '' %>" aria-label="Key">🔑</button>
                <button type="button" class="icon-btn icon-btn-muted" title="Transfer" data-machine-action="transfer" data-mid="<%= row.mid %>" aria-label="Transfer">↔️</button>
                <form method="POST" action="/revoke" style="display:inline" class="js-confirm-revoke" data-mid="<%= row.mid %>">
                  <input type="hidden" name="mid" value="<%= row.mid %>">
                  <button type="submit" class="icon-btn icon-btn-danger" title="Revoke" aria-label="Revoke">🚫</button>
                </form>
              <% } else { %>
                <form method="POST" action="/restore" style="display:inline">
                  <input type="hidden" name="mid" value="<%= row.mid %>">
                  <button type="submit" class="icon-btn icon-btn-success" title="Khôi phục" aria-label="Restore">🔄</button>
                </form>
              <% } %>
              <form method="POST" action="/delete-machine" style="display:inline" class="js-confirm-delete" data-mid="<%= row.mid %>">
                <input type="hidden" name="mid" value="<%= row.mid %>">
                <button type="submit" class="icon-btn icon-btn-danger" title="Xóa" aria-label="Delete">🗑</button>
              </form>
              <a href="/history?mid=<%= encodeURIComponent(row.mid) %>" class="icon-btn icon-btn-muted" title="History" aria-label="History">📜</a>
              <a href="/machine/<%= encodeURIComponent(row.mid) %>" class="icon-btn icon-btn-success" title="Control" aria-label="Control">💻</a>
            </div>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    </div>
    <% } %>
  </div>
</div>

<!-- Modals: Add, Renew, Key, Transfer, Bulk Renew -->
<div class="overlay" id="addOverlay">
  <div class="modal">
    <div class="modal-title">➕ Cấp license mới</div>
    <form method="POST" action="/add" id="addForm">
      <% if (typeof plans !== 'undefined' && plans && plans.length) { %>
      <div class="form-group">
        <label class="form-label">Plan có sẵn (tùy chọn)</label>
        <select id="planPick" class="form-select">
          <option value="">— Không dùng plan —</option>
          <% plans.forEach(function(p) { %>
            <option value="<%= p.id %>" data-tier="<%= p.tier %>" data-max="<%= p.max_players %>" data-trial="<%= p.trial_days || 0 %>" data-expdays="<%= p.expires_days || 0 %>" data-note="<%= p.note || '' %>"><%= p.name %> · <%= TIERS[p.tier].label %></option>
          <% }) %>
        </select>
      </div>
      <% } %>
      <div class="form-group">
        <label class="form-label">Machine ID <span class="text-danger">*</span></label>
        <input name="mid" class="form-input" placeholder="aa:bb:cc:dd:ee:ff|hostname" required autofocus>
        <div class="form-hint">Lấy từ stderr khi gs khởi động lần đầu</div>
      </div>
      <div class="form-group">
        <label class="form-label">Tier</label>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px" id="tierGrid">
          <% [{val:'trial',color:'#fbbf24',label:'Trial',sub:'Dùng thử có hạn'},{val:'basic',color:'#60a5fa',label:'Basic',sub:'Gói cơ bản'},{val:'pro',color:'#a78bfa',label:'Pro',sub:'Gói chuyên nghiệp'},{val:'unlimited',color:'#34d399',label:'Unlimited',sub:'Không giới hạn player'}].forEach(function(t){ %>
          <label class="tier-opt <%= t.val==='trial'?'selected':'' %>" data-tier="<%= t.val %>">
            <input type="radio" name="tier" value="<%= t.val %>" <%= t.val==='trial'?'checked':'' %> style="display:none">
            <div class="tier-label" style="color:<%= t.color %>"><%= t.label %></div>
            <div class="tier-sub"><%= t.sub %></div>
          </label>
          <% }) %>
        </div>
      </div>
      <div class="form-group" id="trialDaysRow">
        <label class="form-label">Số ngày dùng thử</label>
        <input name="trial_days" type="number" value="7" min="1" max="365" class="form-input" style="width:120px">
      </div>
      <div class="form-group" id="maxPlayersRow">
        <label class="form-label">Số player tối đa</label>
        <input name="max_players" type="number" value="10" min="1" max="9999" class="form-input" style="width:120px">
        <div class="form-hint">Vượt giới hạn → client tự chặn login mới</div>
      </div>
      <div class="form-group">
        <label class="form-label">Ngày hết hạn (tùy chọn)</label>
        <input name="expires_at" type="date" class="form-input" style="width:200px">
        <div class="form-hint">Để trống = không hết hạn</div>
      </div>
      <div class="form-group">
        <label class="form-label" style="text-transform:none;letter-spacing:0;font-size:.85rem;font-weight:500">
          <input type="checkbox" name="gen_key" value="1" checked style="margin-right:6px"> Tạo License Key (HEX 32 chars)
        </label>
      </div>
      <div class="form-group">
        <label class="form-label">IP whitelist (tùy chọn)</label>
        <input name="allowed_ips" class="form-input" placeholder="1.2.3.4, 10.0.0.*">
        <div class="form-hint">Hỗ trợ wildcard <code>1.2.3.*</code>. Để trống = mọi IP.</div>
      </div>
      <div class="form-group">
        <label class="form-label">Ghi chú</label>
        <input name="note" class="form-input" placeholder="VD: Anh Tuấn — thử nghiệm">
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline" data-modal-close="addOverlay">Hủy</button>
        <button type="submit" class="btn btn-primary">✅ Cấp phép</button>
      </div>
    </form>
  </div>
</div>

<!-- Renew modal -->
<div class="overlay" id="renewOverlay">
  <div class="modal modal-sm">
    <div class="modal-title">📅 Gia hạn license</div>
    <p class="text-sm text-muted mb-3">Cộng thêm ngày cho <code id="renewMidLabel"></code>.</p>
    <div class="preset-row mb-3">
      <button type="button" class="preset-btn" onclick="setRenewDays(7)">+7d</button>
      <button type="button" class="preset-btn" onclick="setRenewDays(30)">+30d</button>
      <button type="button" class="preset-btn" onclick="setRenewDays(90)">+90d</button>
      <button type="button" class="preset-btn" onclick="setRenewDays(180)">+180d</button>
      <button type="button" class="preset-btn" onclick="setRenewDays(365)">+365d</button>
    </div>
    <form method="POST" action="/renew">
      <input type="hidden" name="mid" id="renewMid">
      <div class="form-group">
        <label class="form-label">Số ngày</label>
        <input name="days" id="renewDaysInput" type="number" value="30" min="1" max="3650" class="form-input" style="width:120px" required>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline" data-modal-close="renewOverlay">Hủy</button>
        <button type="submit" class="btn btn-info">✅ Gia hạn</button>
      </div>
    </form>
  </div>
</div>

<!-- Key modal -->
<div class="overlay" id="keyOverlay">
  <div class="modal modal-sm">
    <div class="modal-title">🔑 License Key</div>
    <p class="text-sm text-muted mb-2">Machine: <code id="keyMidLabel"></code></p>
    <div style="background:var(--panel);border:1px solid var(--border);border-radius:var(--radius-sm);padding:12px;margin-bottom:14px">
      <div class="form-label">Key hiện tại</div>
      <div class="font-mono text-sm" id="keyCurrent" style="word-break:break-all">—</div>
    </div>
    <p class="text-sm text-warning mb-3">⚠️ Key cũ vẫn được chấp nhận <b>24h</b> để server đồng bộ.</p>
    <div class="modal-footer">
      <button type="button" class="btn btn-outline" data-modal-close="keyOverlay">Đóng</button>
      <form method="POST" action="/remove-key" style="display:inline" onsubmit="return confirm('Xóa key — server sẽ AUTH không cần key. Tiếp tục?')">
        <input type="hidden" name="mid" id="keyMidRemove" value="">
        <button type="submit" class="btn btn-danger">🗑 Xóa key</button>
      </form>
      <form method="POST" action="/gen-key" style="display:inline" onsubmit="document.getElementById('keyMidRemove').value = document.getElementById('keyMid').value;">
        <input type="hidden" name="mid" id="keyMid">
        <button type="submit" class="btn btn-primary">🔄 Tạo key mới</button>
      </form>
    </div>
  </div>
</div>

<!-- Transfer modal -->
<div class="overlay" id="transferOverlay">
  <div class="modal">
    <div class="modal-title">↔️ Transfer license</div>
    <p class="text-sm text-muted mb-3">Chuyển license sang Machine ID khác (thay máy / thay HWID).</p>
    <form method="POST" action="/transfer" onsubmit="return confirm('Transfer license sang Machine ID mới?\nMachine cũ sẽ bị xóa.')">
      <input type="hidden" name="old_mid" id="transferOldMid">
      <div class="form-group">
        <label class="form-label">Từ (Machine ID cũ)</label>
        <div style="background:var(--panel);border:1px solid var(--border);border-radius:var(--radius-sm);padding:10px 13px;font-family:monospace;font-size:.85rem;color:#a5b4fc" id="transferOldLabel"></div>
      </div>
      <div class="form-group">
        <label class="form-label">Đến (Machine ID mới) <span class="text-danger">*</span></label>
        <input name="new_mid" class="form-input" placeholder="aa:bb:cc:dd:ee:ff|new-host" required>
        <div class="form-hint">Chưa được tồn tại trong hệ thống</div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline" data-modal-close="transferOverlay">Hủy</button>
        <button type="submit" class="btn btn-info">↔️ Transfer</button>
      </div>
    </form>
  </div>
</div>

<!-- Bulk renew modal -->
<div class="overlay" id="bulkRenewOverlay">
  <div class="modal modal-sm">
    <div class="modal-title">📅 Gia hạn hàng loạt</div>
    <p class="text-sm text-muted mb-3">Gia hạn <strong id="bulkRenewCount">0</strong> máy đã chọn.</p>
    <div class="preset-row mb-3">
      <button type="button" class="preset-btn" onclick="setBulkRenewDays(7)">+7d</button>
      <button type="button" class="preset-btn" onclick="setBulkRenewDays(30)">+30d</button>
      <button type="button" class="preset-btn" onclick="setBulkRenewDays(90)">+90d</button>
      <button type="button" class="preset-btn" onclick="setBulkRenewDays(180)">+180d</button>
      <button type="button" class="preset-btn" onclick="setBulkRenewDays(365)">+365d</button>
    </div>
    <form method="POST" action="/bulk-renew" id="bulkRenewForm2">
      <input type="hidden" name="mids" id="bulkRenewMidsInput">
      <div class="form-group">
        <label class="form-label">Số ngày</label>
        <input name="days" id="bulkRenewDaysInput" type="number" value="30" min="1" max="3650" class="form-input" style="width:120px" required>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline" data-modal-close="bulkRenewOverlay">Hủy</button>
        <button type="submit" class="btn btn-info">✅ Gia hạn</button>
      </div>
    </form>
  </div>
</div>

<!-- Bulk tier form -->
<form method="POST" action="/bulk-tier" id="bulkTierForm" style="display:none">
  <input type="hidden" name="mids" id="bulkTierMids">
  <input type="hidden" name="tier" id="bulkTierValue">
</form>

<script>
// Tier selector
const tierOpts = document.querySelectorAll('#tierGrid .tier-opt');
const trialRow = document.getElementById('trialDaysRow');
const maxRow = document.getElementById('maxPlayersRow');
function updateTierUI(tier) {
  tierOpts.forEach(o => o.classList.toggle('selected', o.dataset.tier === tier));
  if (trialRow) trialRow.style.display = tier === 'trial' ? '' : 'none';
  if (maxRow) maxRow.style.display = tier === 'unlimited' ? 'none' : '';
}
tierOpts.forEach(opt => { opt.addEventListener('click', () => { opt.querySelector('input').checked = true; updateTierUI(opt.dataset.tier); }); });
updateTierUI('trial');

// Filters
const machineSearch = document.getElementById('machineSearch');
const machineStatusFilter = document.getElementById('machineStatusFilter');
const machineTierFilter = document.getElementById('machineTierFilter');
const machineVisibleCount = document.getElementById('machineVisibleCount');
const machineRows = Array.from(document.querySelectorAll('[data-machine-row]'));
function applyMachineFilters() {
  const q = (machineSearch?.value || '').trim().toLowerCase();
  const s = machineStatusFilter?.value || '';
  const t = machineTierFilter?.value || '';
  let visible = 0;
  machineRows.forEach(row => {
    const show = (!q || (row.dataset.search || '').includes(q)) && (!s || row.dataset.status === s) && (!t || row.dataset.tier === t);
    row.style.display = show ? '' : 'none';
    if (show) visible++;
  });
  if (machineVisibleCount) machineVisibleCount.textContent = String(visible);
  updateBulkBar();
}
[machineSearch, machineStatusFilter, machineTierFilter].forEach(el => { if (el) el.addEventListener(el.tagName === 'INPUT' ? 'input' : 'change', applyMachineFilters); });

// Bulk
const selectAllCheckbox = document.getElementById('selectAllCheckbox');
const bulkBar = document.getElementById('bulkBar');
const bulkSelectedCount = document.getElementById('bulkSelectedCount');
const rowCheckboxes = Array.from(document.querySelectorAll('.row-checkbox'));
function getSelectedMids() { return rowCheckboxes.filter(cb => cb.checked).map(cb => cb.dataset.mid); }
function updateBulkBar() {
  const selected = getSelectedMids();
  const count = selected.length;
  if (bulkSelectedCount) bulkSelectedCount.textContent = String(count);
  if (bulkBar) bulkBar.classList.toggle('visible', count > 0);
  const visibleChecked = rowCheckboxes.filter(cb => cb.checked && cb.closest('tr').style.display !== 'none').length;
  const visibleTotal = rowCheckboxes.filter(cb => cb.closest('tr').style.display !== 'none').length;
  if (selectAllCheckbox) { selectAllCheckbox.checked = visibleTotal > 0 && visibleChecked === visibleTotal; selectAllCheckbox.indeterminate = visibleChecked > 0 && visibleChecked < visibleTotal; }
  ['bulkRevokeMids', 'bulkDeleteMids'].forEach(id => { const el = document.getElementById(id); if (el) el.value = JSON.stringify(selected); });
}
if (selectAllCheckbox) selectAllCheckbox.addEventListener('change', () => { const checked = selectAllCheckbox.checked; rowCheckboxes.forEach(cb => { if (cb.closest('tr').style.display !== 'none') cb.checked = checked; }); updateBulkBar(); });
rowCheckboxes.forEach(cb => cb.addEventListener('change', updateBulkBar));
function clearBulkSelection() { rowCheckboxes.forEach(cb => cb.checked = false); if (selectAllCheckbox) { selectAllCheckbox.checked = false; selectAllCheckbox.indeterminate = false; } updateBulkBar(); }
function confirmBulk(action) { const selected = getSelectedMids(); if (!selected.length) return false; return confirm((action === 'revoke' ? 'REVOKE' : 'XÓA') + ' ' + selected.length + ' máy?\n\n' + selected.slice(0,5).join('\n') + (selected.length>5?'\n…và '+(selected.length-5)+' máy khác':'') + '\n\nTiếp tục?'); }
['bulkRevokeForm','bulkDeleteForm'].forEach(fid => { const f = document.getElementById(fid); if (f) f.addEventListener('submit', function(e) { const s = getSelectedMids(); if (!s.length) { e.preventDefault(); return; } }); });
function openBulkRenew() { const s = getSelectedMids(); if (!s.length) return; document.getElementById('bulkRenewCount').textContent = String(s.length); document.getElementById('bulkRenewMidsInput').value = JSON.stringify(s); document.getElementById('bulkRenewDaysInput').value = '30'; showOverlay('bulkRenewOverlay'); }
function setBulkRenewDays(d) { document.getElementById('bulkRenewDaysInput').value = String(d); }
function submitBulkTier(tier) { if (!tier) return; const s = getSelectedMids(); if (!s.length) { document.getElementById('bulkTierSelect').value = ''; return; } if (!confirm('Đổi ' + s.length + ' máy sang tier ' + tier.toUpperCase() + '?')) { document.getElementById('bulkTierSelect').value = ''; return; } document.getElementById('bulkTierMids').value = JSON.stringify(s); document.getElementById('bulkTierValue').value = tier; document.getElementById('bulkTierForm').submit(); }

// Sort
const tbody = document.querySelector('tbody');
let currentSort = { col: null, dir: 'asc' };
document.querySelectorAll('th.sortable').forEach(th => {
  th.addEventListener('click', () => {
    const col = th.dataset.sort;
    const dir = currentSort.col === col && currentSort.dir === 'asc' ? 'desc' : 'asc';
    currentSort = { col, dir };
    document.querySelectorAll('th.sortable').forEach(h => { h.classList.remove('sorted'); const a = h.querySelector('.sort-arrow'); if (a) a.textContent = '↕'; });
    th.classList.add('sorted'); const a = th.querySelector('.sort-arrow'); if (a) a.textContent = dir === 'asc' ? '▲' : '▼';
    const rows = Array.from(tbody.querySelectorAll('[data-machine-row]'));
    const sk = 'data-sort-' + col;
    rows.sort((a,b) => {
      let va = a.getAttribute(sk) || '', vb = b.getAttribute(sk) || '';
      if (col === 'max' || col === 'peak' || col === 'expiry') { va = parseFloat(va); vb = parseFloat(vb); return dir === 'asc' ? va - vb : vb - va; }
      if (col === 'added') return dir === 'asc' ? va.localeCompare(vb) : vb.localeCompare(va);
      if (col === 'status') { const o = {online:0,offline:1,zombie:2,expired:3,revoked:4}; va = o[va]??9; vb = o[vb]??9; return dir === 'asc' ? va - vb : vb - va; }
      if (col === 'tier') { const o = {unlimited:0,pro:1,basic:2,trial:3}; va = o[va]??9; vb = o[vb]??9; return dir === 'asc' ? va - vb : vb - va; }
      return dir === 'asc' ? va.localeCompare(vb) : vb.localeCompare(va);
    });
    rows.forEach(row => tbody.appendChild(row));
  });
});

// Renew
function setRenewDays(d) { document.getElementById('renewDaysInput').value = String(d); }

// Plan picker
const planSel = document.getElementById('planPick');
if (planSel) { planSel.addEventListener('change', () => { const o = planSel.selectedOptions[0]; if (!o || !o.value) return; const f = document.getElementById('addForm'); const tier = o.dataset.tier; const r = f.querySelector('input[name=tier][value="'+tier+'"]'); if (r) r.checked = true; updateTierUI(tier); if (o.dataset.max) f.querySelector('input[name=max_players]').value = o.dataset.max; if (o.dataset.trial && tier === 'trial') f.querySelector('input[name=trial_days]').value = o.dataset.trial; const ed = parseInt(o.dataset.expdays); if (ed > 0) { const d = new Date(); d.setDate(d.getDate() + ed); f.querySelector('input[name=expires_at]').value = d.toISOString().slice(0,10); } if (o.dataset.note) f.querySelector('input[name=note]').value = o.dataset.note; }); }

// Action handlers
const machineActions = {
  renew(btn) { document.getElementById('renewMid').value = btn.dataset.mid||''; document.getElementById('renewMidLabel').textContent = btn.dataset.mid||''; document.getElementById('renewDaysInput').value = '30'; showOverlay('renewOverlay'); },
  key(btn) { const m = btn.dataset.mid||''; document.getElementById('keyMid').value = m; document.getElementById('keyMidRemove').value = m; document.getElementById('keyMidLabel').textContent = m; const cur = document.getElementById('keyCurrent'); const k = btn.dataset.licenseKey||''; cur.textContent = k || '— chưa có key —'; cur.style.color = k ? '#a5b4fc' : ''; showOverlay('keyOverlay'); },
  transfer(btn) { document.getElementById('transferOldMid').value = btn.dataset.mid||''; document.getElementById('transferOldLabel').textContent = btn.dataset.mid||''; showOverlay('transferOverlay'); },
};
document.addEventListener('click', event => {
  const btn = event.target.closest('[data-machine-action]');
  if (btn) { event.preventDefault(); const h = machineActions[btn.dataset.machineAction]; if (h) h(btn); }
});

// Copy license key to clipboard
function copyLicenseKey(btn) {
  var key = (btn.dataset.key || '').trim();
  if (!key) return;
  // Ưu tiên dùng Clipboard API, fallback về textarea nếu không hỗ trợ
  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(key).then(function() {
      btn.textContent = '✅';
      btn.classList.add('copied');
      setTimeout(function() { btn.textContent = '📋'; btn.classList.remove('copied'); }, 1500);
    }).catch(function() {
      fallbackCopy(btn, key);
    });
  } else {
    fallbackCopy(btn, key);
  }
}
function fallbackCopy(btn, key) {
  var ta = document.createElement('textarea');
  ta.value = key;
  ta.style.position = 'fixed';
  ta.style.left = '-9999px';
  ta.style.top = '-9999px';
  document.body.appendChild(ta);
  ta.focus();
  ta.select();
  try {
    var ok = document.execCommand('copy');
    if (ok) {
      btn.textContent = '✅';
      btn.classList.add('copied');
      setTimeout(function() { btn.textContent = '📋'; btn.classList.remove('copied'); }, 1500);
    }
  } catch(e) {}
  document.body.removeChild(ta);
}

// Safe confirm handlers — avoids XSS via unescaped output in inline onsubmit
document.addEventListener('submit', function(e) {
  var form = e.target.closest('form.js-confirm-revoke');
  if (form) {
    var mid = form.getAttribute('data-mid') || '';
    if (!confirm('Thu hồi license:\n' + mid + '\n\nServer sẽ tắt trong ≤5 phút.')) {
      e.preventDefault();
    }
    return;
  }
  form = e.target.closest('form.js-confirm-delete');
  if (form) {
    var mid = form.getAttribute('data-mid') || '';
    if (!confirm('XÓA HOÀN TOÀN:\n' + mid + '\n\nWhitelist, agent, stats, history sẽ bị gỡ.')) {
      e.preventDefault();
    }
  }
});
</script>
</body>
</html>
