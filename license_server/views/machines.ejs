<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Machines — License Manager</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
  <style>
    :root { --bg:#111827; --surface:#1f2937; --border:#374151; --text:#f9fafb; --muted:#9ca3af; --primary:#6366f1; }
    * { box-sizing: border-box; }
    body     { background: radial-gradient(circle at top left, #172033 0, var(--bg) 34%); color: var(--text); font-family: 'Segoe UI', sans-serif; margin: 0; min-height: 100vh; }
    .topbar  { background: var(--surface); border-bottom: 1px solid var(--border);
               padding: 12px 24px; display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap; position: sticky; top: 0; z-index: 20; }
    .topbar-brand { font-weight: 700; font-size: 1.1rem; display: flex; align-items: center; gap: 8px; }
    .topbar-brand i { color: var(--primary); font-size: 1.3rem; }
    .nav-btns { overflow-x: auto; max-width: 100%; padding-bottom: 2px; }
    .nav-btns a { color: #d1d5db; text-decoration: none; padding: 6px 14px;
                  border-radius: 6px; font-size: .875rem; transition: background .15s; }
    .nav-btns a:hover      { background: var(--border); color: #fff; }
    .nav-btns a.active     { background: var(--primary); color: #fff; }
    .nav-btns a.btn-logout { color: #f87171; border: 1px solid #f87171; }
    .nav-btns a.btn-logout:hover { background: #f87171; color: #fff; }
    .page    { padding: 24px; max-width: 1480px; margin: 0 auto; }
    .hero-panel { display: grid; grid-template-columns: minmax(260px, 1fr) auto; gap: 18px; align-items: center;
                  background: rgba(31,41,55,.92);
                  border: 1px solid var(--border); border-radius: 8px; padding: 20px; margin-bottom: 16px; }
    .hero-copy { min-width: 0; }
    .eyebrow { color: #93c5fd; font-size: .76rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; margin-bottom: 6px; }
    .hero-title { margin: 0; font-size: 1.25rem; font-weight: 800; line-height: 1.25; }
    .hero-meta { margin-top: 6px; color: var(--muted); font-size: .86rem; }
    .hero-actions { display: flex; justify-content: flex-end; align-items: center; gap: 10px; flex-wrap: wrap; }
    .hero-link { border: 1px solid var(--border); color: #d1d5db; text-decoration: none; padding: 8px 12px; border-radius: 8px; font-size: .82rem; display: inline-flex; align-items: center; gap: 6px; background: rgba(22,30,46,.7); }
    .hero-link:hover { background: var(--border); color: #fff; }
    .metric-grid { display: grid; grid-template-columns: repeat(4, minmax(150px, 1fr)); gap: 12px; margin-bottom: 18px; }
    .metric-card { background: rgba(31,41,55,.92); border: 1px solid var(--border); border-radius: 8px; padding: 14px 16px; box-shadow: 0 14px 35px rgba(0,0,0,.14); }
    .metric-label { color: var(--muted); font-size: .72rem; text-transform: uppercase; letter-spacing: .05em; font-weight: 700; }
    .metric-value { margin-top: 7px; font-size: 1.55rem; line-height: 1; font-weight: 800; }
    .metric-sub { margin-top: 6px; color: var(--muted); font-size: .76rem; }
    .btn-add { background: var(--primary); color: #fff; border: none; padding: 8px 18px;
               border-radius: 8px; font-size: .875rem; font-weight: 600; cursor: pointer;
               display: flex; align-items: center; gap: 6px; transition: opacity .15s; }
    .btn-add:hover { opacity: .85; }
    .tcard   { background: rgba(31,41,55,.92); border: 1px solid var(--border); border-radius: 8px; overflow: hidden; }
    .table-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px;
                     padding: 14px 16px; border-bottom: 1px solid var(--border); }
    .table-title { display: flex; align-items: center; gap: 8px; font-size: .95rem; font-weight: 700; }
    .table-title i { color: var(--primary); }
    .table-hint { color: var(--muted); font-size: .8rem; }
    .filter-bar { display:grid; grid-template-columns: minmax(220px, 1fr) 160px 160px auto; gap:10px; padding:14px 16px; border-bottom:1px solid var(--border); background:#182132; align-items:center; }
    .filter-input, .filter-select { width:100%; background:#111827; color:var(--text); border:1px solid var(--border); border-radius:8px; padding:8px 10px; font-size:.85rem; outline:none; }
    .filter-input:focus, .filter-select:focus { border-color:var(--primary); }
    .filter-count { color:var(--muted); font-size:.8rem; white-space:nowrap; text-align:right; }
    .table-scroll { width: 100%; overflow-x: auto; }
    table    { width: 100%; min-width: 1160px; border-collapse: collapse; }
    thead th { background: #161e2e; color: #9ca3af; font-size: .78rem; font-weight: 600;
               text-transform: uppercase; letter-spacing: .05em; padding: 12px 16px; text-align: left; white-space: nowrap; }
    tbody tr { border-bottom: 1px solid var(--border); transition: background .1s; }
    tbody tr:last-child { border-bottom: none; }
    tbody tr:hover { background: #273044; }
    tbody td { padding: 12px 16px; font-size: .875rem; color: var(--text); vertical-align: middle; }
    .empty-state { padding: 60px 20px; text-align: center; color: var(--muted); }
    .empty-state i { font-size: 2.5rem; display: block; margin-bottom: 12px; color: var(--border); }
    .pill        { display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: .75rem; font-weight: 700; white-space: nowrap; }
    .pill-green  { background: #064e3b; color: #34d399; }
    .pill-red    { background: #7f1d1d; color: #f87171; }
    .pill-gray   { background: #374151; color: #9ca3af; }
    .action-row { display:flex; gap:5px; align-items:center; flex-wrap:wrap; }
    .icon-btn { width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;
                border: 1px solid transparent; border-radius: 6px; color: #fff; cursor: pointer;
                text-decoration: none; font-size: .86rem; transition: opacity .15s, transform .15s; }
    .icon-btn:hover { opacity: .88; transform: translateY(-1px); color: #fff; }
    .icon-btn-primary { background: var(--primary); }
    .icon-btn-info { background: #0e7490; }
    .icon-btn-purple { background: #7c3aed; }
    .icon-btn-muted { background: #475569; }
    .icon-btn-success { background: #065f46; color: #d1fae5; }
    .icon-btn-danger { background: #991b1b; color: #fee2e2; }
    code { background: #161e2e; color: #a5b4fc; padding: 2px 6px; border-radius: 4px; font-size: .78rem; }
    /* Tier badges */
    .tier-badge { display: inline-block; padding: 3px 9px; border-radius: 999px; font-size: .72rem; font-weight: 700; }
    /* Expiry */
    .expiry-ok      { color: #34d399; font-size: .8rem; }
    .expiry-warn    { color: #fbbf24; font-size: .8rem; }
    .expiry-expired { color: #f87171; font-size: .8rem; font-weight: 700; }
    /* Inline number input */
    .num-input { width: 70px; background: #161e2e; color: #f9fafb;
                 border: 1px solid #374151; border-radius: 6px; padding: 4px 8px; font-size: .85rem; }
    .num-input:focus { outline: none; border-color: var(--primary); }
    .btn-tiny  { background: var(--primary); color: #fff; border: none; border-radius: 6px;
                 padding: 4px 8px; font-size: .8rem; cursor: pointer; }
    .btn-tiny:hover { opacity: .85; }
    /* Bulk action bar */
    .bulk-bar { display:none; align-items:center; gap:8px; padding:10px 16px;
                background:#1a1f3a; border-bottom:1px solid var(--border); flex-wrap:wrap; }
    .bulk-bar.visible { display:flex; }
    .bulk-bar .bulk-count { color:var(--primary); font-weight:700; font-size:.85rem; white-space:nowrap; }
    .bulk-bar .bulk-actions { display:flex; gap:5px; align-items:center; flex-wrap:wrap; }
    .bulk-btn { padding:6px 12px; border:none; border-radius:6px; font-size:.78rem;
                font-weight:600; cursor:pointer; display:flex; align-items:center; gap:4px;
                color:#fff; transition:opacity .15s; white-space:nowrap; }
    .bulk-btn:hover { opacity:.85; }
    .bulk-btn-revoke  { background:#991b1b; }
    .bulk-btn-renew   { background:#0e7490; }
    .bulk-btn-delete  { background:#7f1d1d; }
    .bulk-btn-tier    { background:#7c3aed; }
    .bulk-select { width:18px; height:18px; accent-color:var(--primary); cursor:pointer; flex-shrink:0; }
    /* Sortable headers */
    th.sortable { cursor:pointer; user-select:none; position:relative; padding-right:24px !important; }
    th.sortable:hover { color:#fff; background:#1e2a44; }
    th.sortable .sort-arrow { position:absolute; right:6px; font-size:.65rem; opacity:.4; }
    th.sortable.sorted .sort-arrow { opacity:1; color:var(--primary); }
    /* Sparkline */
    .sparkline-svg { width:80px; height:28px; vertical-align:middle; }
    .sparkline-svg line { stroke:#374151; stroke-width:0.5; }
    .sparkline-svg polyline { fill:none; stroke:var(--primary); stroke-width:1.5; stroke-linejoin:round; stroke-linecap:round; }
    .no-sparkline { font-size:.68rem; color:var(--muted); font-style:italic; }
    /* Renew presets */
    .preset-row { display:flex; gap:6px; flex-wrap:wrap; margin-bottom:12px; }
    .preset-btn { background:transparent; color:var(--text); border:1px solid var(--border);
                  padding:5px 10px; border-radius:6px; font-size:.76rem; font-weight:600;
                  cursor:pointer; transition:all .15s; }
    .preset-btn:hover { border-color:var(--primary); color:var(--primary); background:#1a1f3a; }
    /* Bulk tier inline select */
    .bulk-tier-select { background:#111827; color:#fff; border:1px solid var(--border);
                        border-radius:6px; padding:5px 8px; font-size:.78rem; }
    /* Modal */
    .overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.7); z-index: 100; align-items: center; justify-content: center; }
    .overlay.show { display: flex; }
    .modal-box { background: var(--surface); border: 1px solid var(--border); border-radius: 8px;
                 padding: 28px; width: 480px; max-width: 95vw; max-height: 90vh; overflow-y: auto; }
    .modal-box h5 { margin: 0 0 20px; font-size: 1rem; font-weight: 700; display: flex; align-items: center; gap: 8px; }
    .form-group { margin-bottom: 14px; }
    .form-group label { display: block; font-size: .78rem; font-weight: 600; color: var(--muted);
                        text-transform: uppercase; letter-spacing: .05em; margin-bottom: 5px; }
    .form-group input, .form-group select {
      width: 100%; background: #161e2e; color: var(--text); border: 1px solid var(--border);
      border-radius: 8px; padding: 9px 12px; font-size: .875rem; outline: none; }
    .form-group input:focus, .form-group select:focus { border-color: var(--primary); }
    .form-group .hint { font-size: .73rem; color: var(--muted); margin-top: 4px; }
    .modal-footer-btns { display: flex; gap: 10px; justify-content: flex-end; margin-top: 20px; }
    .btn-cancel { background: transparent; color: var(--muted); border: 1px solid var(--border);
                  padding: 8px 18px; border-radius: 8px; font-size: .875rem; cursor: pointer; }
    .btn-cancel:hover { background: var(--border); color: var(--text); }
    .btn-submit { background: var(--primary); color: #fff; border: none; padding: 8px 18px;
                  border-radius: 8px; font-size: .875rem; font-weight: 600; cursor: pointer; }
    .btn-submit:hover { opacity: .85; }
    /* Tier selector grid */
    .tier-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
    .tier-opt  { border: 2px solid var(--border); border-radius: 8px; padding: 10px 12px;
                 cursor: pointer; transition: all .15s; }
    .tier-opt:hover { border-color: var(--primary); }
    .tier-opt input[type=radio] { display: none; }
    .tier-opt input[type=radio]:checked ~ .tier-label { font-weight: 700; }
    .tier-opt.selected { border-color: var(--primary); background: #1a1f3a; }
    .tier-label { font-size: .85rem; font-weight: 600; }
    .tier-sub   { font-size: .72rem; color: var(--muted); margin-top: 2px; }
    /* trial_days row */
    .trial-only { display: none; }
    @media (max-width: 900px) {
      .hero-panel { grid-template-columns: 1fr; }
      .hero-actions { justify-content: flex-start; }
      .metric-grid { grid-template-columns: repeat(2, minmax(140px, 1fr)); }
      .filter-bar { grid-template-columns: 1fr 1fr; }
      .page { padding: 18px; }
    }
    @media (max-width: 560px) {
      .metric-grid { grid-template-columns: 1fr; }
      .table-toolbar { align-items: flex-start; flex-direction: column; }
      .filter-bar { grid-template-columns: 1fr; }
      .filter-count { text-align:left; }
      .btn-add { width: 100%; justify-content: center; }
    }
  </style>
</head>
<body>

<div class="topbar">
  <div class="topbar-brand">
    <i class="bi bi-shield-lock-fill"></i>License Manager
  </div>
  <div class="nav-btns d-flex gap-1">
    <a href="/">Dashboard</a>
    <a href="/machines" class="active">Machines</a>
    <a href="/plans">Plans</a>
    <a href="/operations">Operations</a>
    <a href="/bans">IP Bans</a>
    <a href="/history">History</a>
    <a href="/logs">Logs</a>
    <a href="/settings">Settings</a>
    <a href="/logout" class="btn-logout">Logout</a>
  </div>
</div>

<div class="page">

  <%- include('partials/flash-toast', { flash: flash }) %>

  <%
    var machineRows = Array.isArray(rows) ? rows : [];
    var totalMachines = machineRows.length;
    var onlineMachines = machineRows.filter(function(row) { return row.isOnline && !row.revoked && !row.expired; }).length;
    var expiringSoon = machineRows.filter(function(row) {
      return row.expiry && !row.expired && Number(row.expiry.daysLeft) <= 3;
    }).length;
    var revokedMachines = machineRows.filter(function(row) { return row.revoked; }).length;
  %>

  <section class="hero-panel">
    <div class="hero-copy">
      <div class="eyebrow">License server</div>
      <h1 class="hero-title">Quản lý license theo từng machine</h1>
      <div class="hero-meta">Theo dõi trạng thái, hạn dùng, license key, IP lock và thao tác quản trị trên từng dòng.</div>
    </div>
    <div class="hero-actions">
      <a class="hero-link" href="/plans"><i class="bi bi-layers"></i>Plans</a>
      <a class="hero-link" href="/import"><i class="bi bi-upload"></i>Import</a>
      <button class="btn-add" data-modal-open="addOverlay">
        <i class="bi bi-plus-lg"></i> Cấp license mới
      </button>
    </div>
  </section>

  <section class="metric-grid" aria-label="Tổng quan license">
    <div class="metric-card">
      <div class="metric-label">Tổng machine</div>
      <div class="metric-value"><%= totalMachines %></div>
      <div class="metric-sub">Đang có trong whitelist</div>
    </div>
    <div class="metric-card">
      <div class="metric-label">Online</div>
      <div class="metric-value" style="color:#34d399"><%= onlineMachines %></div>
      <div class="metric-sub">Heartbeat còn hoạt động</div>
    </div>
    <div class="metric-card">
      <div class="metric-label">Sắp hết hạn</div>
      <div class="metric-value" style="color:#fbbf24"><%= expiringSoon %></div>
      <div class="metric-sub">Còn 3 ngày hoặc ít hơn</div>
    </div>
    <div class="metric-card">
      <div class="metric-label">Revoked</div>
      <div class="metric-value" style="color:#f87171"><%= revokedMachines %></div>
      <div class="metric-sub">Đã thu hồi quyền dùng</div>
    </div>
  </section>

  <div class="tcard">
    <div class="table-toolbar">
      <div class="table-title">
        <i class="bi bi-hdd-stack"></i>
        Danh sách license
      </div>
      <div class="table-hint"><%= totalMachines %> machine · thao tác trực tiếp trên từng dòng</div>
    </div>
    <% if (rows.length === 0) { %>
    <div class="empty-state">
      <i class="bi bi-hdd-x"></i>
      Chưa có máy nào được cấp phép
    </div>
    <% } else { %>
    <div class="filter-bar">
      <input id="machineSearch" class="filter-input" type="search" placeholder="Tìm machine, ghi chú, key, IP...">
      <select id="machineStatusFilter" class="filter-select" data-filter-status>
        <option value="">Tất cả trạng thái</option>
        <option value="online">Online</option>
        <option value="offline">Offline</option>
        <option value="expired">Expired</option>
        <option value="revoked">Revoked</option>
        <option value="zombie">Zombie</option>
      </select>
      <select id="machineTierFilter" class="filter-select" data-filter-tier>
        <option value="">Tất cả tier</option>
        <option value="trial">Trial</option>
        <option value="basic">Basic</option>
        <option value="pro">Pro</option>
        <option value="unlimited">Unlimited</option>
      </select>
      <div class="filter-count"><span id="machineVisibleCount"><%= rows.length %></span>/<%= rows.length %> đang hiển thị</div>
    </div>
    <div class="bulk-bar" id="bulkBar">
      <div class="bulk-count"><span id="bulkSelectedCount">0</span> đã chọn</div>
      <div class="bulk-actions">
        <form method="POST" action="/bulk-revoke" id="bulkRevokeForm" onsubmit="return confirmBulk('revoke')">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="mids" id="bulkRevokeMids">
          <button type="submit" class="bulk-btn bulk-btn-revoke"><i class="bi bi-slash-circle"></i> Revoke</button>
        </form>
        <button type="button" class="bulk-btn bulk-btn-renew" onclick="openBulkRenew()"><i class="bi bi-calendar-plus"></i> Gia hạn</button>
        <form method="POST" action="/bulk-delete" id="bulkDeleteForm" onsubmit="return confirmBulk('delete')">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="mids" id="bulkDeleteMids">
          <button type="submit" class="bulk-btn bulk-btn-delete"><i class="bi bi-trash"></i> Xóa</button>
        </form>
        <select class="bulk-tier-select" id="bulkTierSelect" onchange="submitBulkTier(this.value)">
          <option value="">Đổi tier →</option>
          <option value="trial">Trial</option>
          <option value="basic">Basic</option>
          <option value="pro">Pro</option>
          <option value="unlimited">Unlimited</option>
        </select>
        <button type="button" class="bulk-btn" style="background:#374151" onclick="clearBulkSelection()">
          <i class="bi bi-x-lg"></i> Bỏ chọn
        </button>
      </div>
    </div>
    <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th style="width:30px"><input type="checkbox" class="bulk-select" id="selectAllCheckbox" title="Chọn tất cả"></th>
          <th class="sortable" data-sort="mid">Machine ID <span class="sort-arrow">↕</span></th>
          <th class="sortable" data-sort="tier">Tier <span class="sort-arrow">↕</span></th>
          <th class="sortable" data-sort="max">Max Players <span class="sort-arrow">↕</span></th>
          <th class="sortable" data-sort="peak">Peak <span class="sort-arrow">↕</span></th>
          <th class="sortable" data-sort="status">Trạng thái <span class="sort-arrow">↕</span></th>
          <th class="sortable" data-sort="expiry">Hết hạn <span class="sort-arrow">↕</span></th>
          <th class="sortable" data-sort="note">Ghi chú <span class="sort-arrow">↕</span></th>
          <th class="sortable" data-sort="added">Ngày cấp <span class="sort-arrow">↕</span></th>
          <th>Hành động</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(function(row) {
             var tier = row.tier || 'basic';
             var td   = TIERS[tier] || TIERS.basic;
             var rowStatus = row.revoked ? 'revoked' : row.expired ? 'expired' : row.zombie ? 'zombie' : row.isOnline ? 'online' : 'offline';
             var searchText = [
               row.mid, tier, row.note, row.license_key,
               Array.isArray(row.allowed_ips) ? row.allowed_ips.join(' ') : '',
               rowStatus
             ].filter(Boolean).join(' ').toLowerCase();
             // Sort data
             var sortPeak = row.peak_players || 0;
             var sortMax  = row.max_players || 0;
             var sortExpiry = row.expiry ? row.expiry.daysLeft : 9999;
             var sortAdded = row.added || '';
        %>
        <tr data-machine-row data-search="<%= searchText %>" data-status="<%= rowStatus %>" data-tier="<%= tier %>"
            data-sort-mid="<%= row.mid.toLowerCase() %>"
            data-sort-tier="<%= tier %>"
            data-sort-max="<%= sortMax %>"
            data-sort-peak="<%= sortPeak %>"
            data-sort-status="<%= rowStatus %>"
            data-sort-expiry="<%= sortExpiry %>"
            data-sort-note="<%= (row.note || '').toLowerCase() %>"
            data-sort-added="<%= sortAdded %>">
          <!-- Checkbox -->
          <td style="text-align:center">
            <input type="checkbox" class="bulk-select row-checkbox" data-mid="<%= row.mid %>">
          </td>
          <!-- Machine ID -->
          <td>
            <code><%= row.mid %></code>
            <% if (row.auto) { %>
              <span class="pill" style="background:#374151;color:#9ca3af;margin-left:4px;font-size:.68rem">Auto</span>
            <% } %>
            <% if (row.license_key) { %>
              <div style="font-size:.7rem;color:var(--muted);margin-top:4px;font-family:monospace"
                   title="License key">
                <i class="bi bi-key-fill" style="color:#a78bfa"></i>
                <%= row.license_key.slice(0, 8) %>…<%= row.license_key.slice(-4) %>
              </div>
            <% } %>
            <% if (Array.isArray(row.allowed_ips) && row.allowed_ips.length) { %>
              <div style="font-size:.7rem;color:#fbbf24;margin-top:2px"
                   title="<%= row.allowed_ips.join(', ') %>">
                <i class="bi bi-shield-fill"></i> IP locked (<%= row.allowed_ips.length %>)
              </div>
            <% } %>
          </td>

          <!-- Tier badge -->
          <td>
            <span class="tier-badge" style="background:<%= td.bg %>;color:<%= td.color %>">
              <%= td.label %>
            </span>
          </td>

          <!-- Max Players (inline edit) -->
          <td>
            <form method="POST" action="/update-limit" style="display:flex;gap:4px;align-items:center">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="mid" value="<%= row.mid %>">
              <input type="number" name="max_players" value="<%= row.max_players %>"
                     min="1" max="9999" class="num-input">
              <button type="submit" class="btn-tiny" title="Lưu"><i class="bi bi-check-lg"></i></button>
            </form>
          </td>

          <!-- Peak players -->
          <td style="color:#fbbf24;font-weight:700">
            <%= row.peak_players || 0 %>
          </td>

          <!-- Status -->
          <td>
            <% if (row.revoked) { %>
              <span class="pill pill-red">Revoked</span>
            <% } else if (row.expired) { %>
              <span class="pill pill-red">Expired</span>
            <% } else if (row.zombie) { %>
              <span class="pill" style="background:#451a03;color:#fbbf24">Zombie</span>
            <% } else if (row.isOnline) { %>
              <span class="pill pill-green">● Online</span>
              <div style="font-size:.72rem;color:var(--muted);margin-top:3px">
                <%= row.currentPlayers %>/<%= row.max_players %> players
              </div>
              <% if (row.sparkline) { %>
                <svg class="sparkline-svg" data-sparkline="<%= row.sparkline %>" data-max="<%= row.max_players %>"
                     style="margin-top:3px" viewBox="0 0 80 28" preserveAspectRatio="none"></svg>
              <% } %>
            <% } else { %>
              <span class="pill pill-gray">Offline</span>
              <% if (row.sparkline) { %>
                <svg class="sparkline-svg" data-sparkline="<%= row.sparkline %>" data-max="<%= row.max_players %>"
                     style="margin-top:3px;opacity:.5" viewBox="0 0 80 28" preserveAspectRatio="none"></svg>
              <% } %>
            <% } %>
          </td>

          <!-- Expiry -->
          <td>
            <% if (row.expiry) {
                 if (row.expired) { %>
                   <span class="expiry-expired"><i class="bi bi-x-circle me-1"></i>Hết hạn <%= row.expiry.date %></span>
            <%   } else if (row.expiry.daysLeft <= 3) { %>
                   <span class="expiry-warn"><i class="bi bi-exclamation-triangle me-1"></i><%= row.expiry.daysLeft %>d còn lại</span>
            <%   } else { %>
                   <span class="expiry-ok"><i class="bi bi-calendar-check me-1"></i><%= row.expiry.daysLeft %>d — <%= row.expiry.date %></span>
            <%   }
               } else { %>
               <span style="color:var(--muted);font-size:.8rem">—</span>
            <% } %>
          </td>

          <!-- Note -->
          <td style="color:var(--muted);max-width:180px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis" title="<%= row.note||'' %>">
            <%= row.note || '—' %>
          </td>

          <!-- Added -->
          <td style="color:var(--muted);font-size:.78rem;white-space:nowrap"><%= row.added %></td>

          <!-- Actions -->
          <td style="white-space:nowrap">
            <div class="action-row">
              <% if (!row.revoked) { %>
                <button type="button" class="icon-btn icon-btn-info"
                        title="Gia hạn"
                        aria-label="Gia hạn"
                        data-machine-action="renew"
                        data-mid="<%= row.mid %>">
                  <i class="bi bi-calendar-plus"></i>
                </button>
                <button type="button" class="icon-btn icon-btn-purple"
                        title="Tạo / đổi license key"
                        aria-label="Tạo hoặc đổi license key"
                        data-machine-action="key"
                        data-mid="<%= row.mid %>"
                        data-license-key="<%= row.license_key || '' %>">
                  <i class="bi bi-key"></i>
                </button>
                <button type="button" class="icon-btn icon-btn-muted"
                        title="Transfer"
                        aria-label="Transfer license"
                        data-machine-action="transfer"
                        data-mid="<%= row.mid %>">
                  <i class="bi bi-arrow-left-right"></i>
                </button>
                <form method="POST" action="/revoke" style="display:inline"
                      onsubmit="return confirm(<%- JSON.stringify(`Thu hồi license của:\n${row.mid}\n\nServer sẽ tắt trong ≤5 phút.`) %>)">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="mid" value="<%= row.mid %>">
                  <button type="submit" class="icon-btn icon-btn-danger" title="Thu hồi license" aria-label="Thu hồi license">
                    <i class="bi bi-slash-circle"></i>
                  </button>
                </form>
              <% } else { %>
                <form method="POST" action="/restore" style="display:inline">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="mid" value="<%= row.mid %>">
                  <button type="submit" class="icon-btn icon-btn-success" title="Khôi phục license" aria-label="Khôi phục license">
                    <i class="bi bi-arrow-counterclockwise"></i>
                  </button>
                </form>
              <% } %>
              <form method="POST" action="/delete-machine" style="display:inline"
                    onsubmit="return confirm(<%- JSON.stringify(`XÓA HOÀN TOÀN machine:\n${row.mid}\n\nWhitelist, agent token, stats và lịch sử active sẽ bị gỡ.\nKhách sẽ phải được cấp lại từ đầu (auto-register sẽ sinh key mới).\n\nTiếp tục?`) %>)">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="mid" value="<%= row.mid %>">
                <button type="submit" class="icon-btn icon-btn-danger" title="Xóa machine khỏi hệ thống" aria-label="Xóa machine khỏi hệ thống">
                  <i class="bi bi-trash"></i>
                </button>
              </form>
              <a href="/history?mid=<%= encodeURIComponent(row.mid) %>"
                 class="icon-btn icon-btn-muted"
                 title="Xem lịch sử" aria-label="Xem lịch sử"><i class="bi bi-clock-history"></i></a>
              <a href="/machine/<%= encodeURIComponent(row.mid) %>"
                 class="icon-btn icon-btn-success"
                 title="SSH / Server control" aria-label="SSH / Server control"><i class="bi bi-terminal"></i></a>
            </div>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    </div>
    <% } %>
  </div>
</div>

<!-- ── Modal cấp license mới ──────────────────────────────────────────────── -->
<div class="overlay" id="addOverlay">
  <div class="modal-box">
    <h5>
      <i class="bi bi-plus-circle" style="color:var(--primary)"></i>
      Cấp license mới
    </h5>
    <form method="POST" action="/add" id="addForm">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <% if (plans && plans.length) { %>
      <div class="form-group">
        <label>Áp dụng plan có sẵn (tùy chọn)</label>
        <select id="planPick" style="width:100%;background:#161e2e;color:var(--text);border:1px solid var(--border);border-radius:8px;padding:9px 12px;font-size:.875rem">
          <option value="">— Không dùng plan —</option>
          <% plans.forEach(function(p) { %>
            <option value="<%= p.id %>"
                    data-tier="<%= p.tier %>"
                    data-max="<%= p.max_players %>"
                    data-trial="<%= p.trial_days || 0 %>"
                    data-expdays="<%= p.expires_days || 0 %>"
                    data-note="<%= p.note || '' %>"><%= p.name %> · <%= TIERS[p.tier].label %></option>
          <% }) %>
        </select>
        <div class="hint">Chọn plan để tự fill các trường bên dưới</div>
      </div>
      <% } %>

      <div class="form-group">
        <label>Machine ID <span style="color:#f87171">*</span></label>
        <input name="mid" placeholder="aa:bb:cc:dd:ee:ff|hostname" required autofocus>
        <div class="hint">Lấy từ stderr khi gs khởi động lần đầu</div>
      </div>

      <!-- Tier selector -->
      <div class="form-group">
        <label>Tier</label>
        <div class="tier-grid" id="tierGrid">
          <label class="tier-opt selected" data-tier="trial">
            <input type="radio" name="tier" value="trial" checked>
            <div class="tier-label" style="color:#fbbf24">Trial</div>
            <div class="tier-sub">Dùng thử có giới hạn ngày</div>
          </label>
          <label class="tier-opt" data-tier="basic">
            <input type="radio" name="tier" value="basic">
            <div class="tier-label" style="color:#60a5fa">Basic</div>
            <div class="tier-sub">Gói cơ bản</div>
          </label>
          <label class="tier-opt" data-tier="pro">
            <input type="radio" name="tier" value="pro">
            <div class="tier-label" style="color:#a78bfa">Pro</div>
            <div class="tier-sub">Gói chuyên nghiệp</div>
          </label>
          <label class="tier-opt" data-tier="unlimited">
            <input type="radio" name="tier" value="unlimited">
            <div class="tier-label" style="color:#34d399">Unlimited</div>
            <div class="tier-sub">Không giới hạn player</div>
          </label>
        </div>
      </div>

      <!-- Trial days — chỉ hiển thị khi chọn Trial -->
      <div class="form-group trial-only" id="trialDaysRow">
        <label>Số ngày dùng thử</label>
        <input name="trial_days" type="number" value="7" min="1" max="365">
        <div class="hint">License tự hết hạn sau N ngày kể từ lúc cấp</div>
      </div>

      <!-- Max players (ẩn khi unlimited) -->
      <div class="form-group" id="maxPlayersRow">
        <label>Số player tối đa</label>
        <input name="max_players" type="number" value="20" min="1" max="9999">
        <div class="hint">Vượt giới hạn này → server tự tắt trong ≤5 phút</div>
      </div>

      <!-- Expires at (tùy chọn) -->
      <div class="form-group">
        <label>Ngày hết hạn (tùy chọn)</label>
        <input name="expires_at" type="date">
        <div class="hint">Để trống = không hết hạn theo ngày cố định</div>
      </div>

      <!-- License key generation -->
      <div class="form-group">
        <label style="display:flex;align-items:center;gap:8px;text-transform:none;letter-spacing:0;font-size:.85rem;color:var(--text);font-weight:500">
          <input type="checkbox" name="gen_key" value="1" checked
                 style="width:auto;margin:0">
          Tạo License Key (HEX 32 chars)
        </label>
        <div class="hint">Server chỉ chấp nhận AUTH khi client gửi đúng key này</div>
      </div>

      <!-- IP whitelist -->
      <div class="form-group">
        <label>IP whitelist (tùy chọn)</label>
        <input name="allowed_ips" placeholder="VD: 1.2.3.4, 10.0.0.* (mỗi IP cách nhau , hoặc xuống dòng)">
        <div class="hint">Hỗ trợ wildcard <code>1.2.3.*</code>. Để trống = chấp nhận mọi IP</div>
      </div>

      <div class="form-group">
        <label>Ghi chú</label>
        <input name="note" placeholder="VD: Anh Tuấn — thử nghiệm tháng 1/2025">
      </div>

      <div class="modal-footer-btns">
        <button type="button" class="btn-cancel" data-modal-close="addOverlay">Hủy</button>
        <button type="submit" class="btn-submit">
          <i class="bi bi-check-lg me-1"></i>Cấp phép
        </button>
      </div>
    </form>
  </div>
</div>

