<!-- ── Hidden bulk tier form ───────────────────────────────────────────────── -->
<form method="POST" action="/bulk-tier" id="bulkTierForm" style="display:none">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="mids" id="bulkTierMids">
  <input type="hidden" name="tier" id="bulkTierValue">
</form>

<script>
  // ═══════════════════════════════════════════════════════════════════════════
  // Tier selector logic
  // ═══════════════════════════════════════════════════════════════════════════
  const tierOpts = document.querySelectorAll('.tier-opt');
  const trialRow = document.getElementById('trialDaysRow');
  const maxRow   = document.getElementById('maxPlayersRow');

  function updateTierUI(tier) {
    tierOpts.forEach(o => o.classList.toggle('selected', o.dataset.tier === tier));
    trialRow.style.display = tier === 'trial'     ? 'block' : 'none';
    maxRow.style.display   = tier === 'unlimited' ? 'none'  : 'block';
  }

  tierOpts.forEach(opt => {
    opt.addEventListener('click', () => {
      const tier = opt.dataset.tier;
      opt.querySelector('input[type=radio]').checked = true;
      updateTierUI(tier);
    });
  });

  updateTierUI('trial');

  // ═══════════════════════════════════════════════════════════════════════════
  // Filters
  // ═══════════════════════════════════════════════════════════════════════════
  const machineSearch = document.getElementById('machineSearch');
  const machineStatusFilter = document.getElementById('machineStatusFilter');
  const machineTierFilter = document.getElementById('machineTierFilter');
  const machineVisibleCount = document.getElementById('machineVisibleCount');
  const machineRows = Array.from(document.querySelectorAll('[data-machine-row]'));

  function applyMachineFilters() {
    const query = (machineSearch?.value || '').trim().toLowerCase();
    const status = machineStatusFilter?.value || '';
    const tier = machineTierFilter?.value || '';
    let visible = 0;

    machineRows.forEach(row => {
      const matchesQuery = !query || (row.dataset.search || '').includes(query);
      const matchesStatus = !status || row.dataset.status === status;
      const matchesTier = !tier || row.dataset.tier === tier;
      const show = matchesQuery && matchesStatus && matchesTier;
      row.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    if (machineVisibleCount) machineVisibleCount.textContent = String(visible);
  }

  [machineSearch, machineStatusFilter, machineTierFilter].forEach(el => {
    if (el) el.addEventListener(el.tagName === 'INPUT' ? 'input' : 'change', applyMachineFilters);
  });

  // ═══════════════════════════════════════════════════════════════════════════
  // Bulk selection
  // ═══════════════════════════════════════════════════════════════════════════
  const selectAllCheckbox = document.getElementById('selectAllCheckbox');
  const bulkBar = document.getElementById('bulkBar');
  const bulkSelectedCount = document.getElementById('bulkSelectedCount');
  const rowCheckboxes = Array.from(document.querySelectorAll('.row-checkbox'));

  function getSelectedMids() {
    return rowCheckboxes.filter(cb => cb.checked).map(cb => cb.dataset.mid);
  }

  function updateBulkBar() {
    const selected = getSelectedMids();
    const count = selected.length;
    bulkSelectedCount.textContent = String(count);
    bulkBar.classList.toggle('visible', count > 0);

    // Cập nhật select all state
    const visibleChecked = rowCheckboxes.filter(cb => cb.checked && cb.closest('tr').style.display !== 'none').length;
    const visibleTotal = rowCheckboxes.filter(cb => cb.closest('tr').style.display !== 'none').length;
    selectAllCheckbox.checked = visibleTotal > 0 && visibleChecked === visibleTotal;
    selectAllCheckbox.indeterminate = visibleChecked > 0 && visibleChecked < visibleTotal;

    // Cập nhật hidden inputs cho bulk forms
    const midsJson = JSON.stringify(selected);
    ['bulkRevokeMids', 'bulkDeleteMids'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.value = midsJson;
    });
  }

  selectAllCheckbox.addEventListener('change', () => {
    const checked = selectAllCheckbox.checked;
    rowCheckboxes.forEach(cb => {
      if (cb.closest('tr').style.display !== 'none') cb.checked = checked;
    });
    updateBulkBar();
  });

  rowCheckboxes.forEach(cb => {
    cb.addEventListener('change', updateBulkBar);
  });

  function clearBulkSelection() {
    rowCheckboxes.forEach(cb => cb.checked = false);
    selectAllCheckbox.checked = false;
    selectAllCheckbox.indeterminate = false;
    updateBulkBar();
  }

  function confirmBulk(action) {
    const selected = getSelectedMids();
    if (!selected.length) return false;
    const label = action === 'revoke' ? 'REVOKE' : 'XÓA HOÀN TOÀN';
    return confirm(label + ' ' + selected.length + ' máy?\n\n' + selected.slice(0, 5).join('\n') + (selected.length > 5 ? '\n…và ' + (selected.length - 5) + ' máy khác' : '') + '\n\nTiếp tục?');
  }

  // Override bulk revoke/delete form submit để gắn mids
  ['bulkRevokeForm', 'bulkDeleteForm'].forEach(fid => {
    const f = document.getElementById(fid);
    if (f) {
      f.addEventListener('submit', function(e) {
        const selected = getSelectedMids();
        if (!selected.length) { e.preventDefault(); return; }
        const midsInput = fid === 'bulkRevokeForm'
          ? document.getElementById('bulkRevokeMids')
          : document.getElementById('bulkDeleteMids');
        if (midsInput) midsInput.value = JSON.stringify(selected);
      });
    }
  });

  // Bulk renew modal
  function openBulkRenew() {
    const selected = getSelectedMids();
    if (!selected.length) return;
    document.getElementById('bulkRenewCount').textContent = String(selected.length);
    document.getElementById('bulkRenewMidsInput').value = JSON.stringify(selected);
    document.getElementById('bulkRenewDaysInput').value = '30';
    showOverlay('bulkRenewOverlay');
  }

  function setBulkRenewDays(days) {
    const input = document.getElementById('bulkRenewDaysInput');
    if (input) input.value = String(days);
    // Highlight preset
    document.querySelectorAll('#bulkRenewOverlay .preset-btn').forEach(b => {
      b.style.borderColor = parseInt(b.textContent) === days ? 'var(--primary)' : 'var(--border)';
      b.style.color = parseInt(b.textContent) === days ? 'var(--primary)' : 'var(--text)';
    });
  }

  // Bulk tier
  function submitBulkTier(tier) {
    if (!tier) return;
    const selected = getSelectedMids();
    if (!selected.length) { document.getElementById('bulkTierSelect').value = ''; return; }
    if (!confirm('Đổi ' + selected.length + ' máy sang tier ' + tier.toUpperCase() + '?\n\nTiếp tục?')) {
      document.getElementById('bulkTierSelect').value = '';
      return;
    }
    document.getElementById('bulkTierMids').value = JSON.stringify(selected);
    document.getElementById('bulkTierValue').value = tier;
    document.getElementById('bulkTierForm').submit();
  }

  // ═══════════════════════════════════════════════════════════════════════════
  // Sortable columns
  // ═══════════════════════════════════════════════════════════════════════════
  const tbody = document.querySelector('tbody');
  let currentSort = { col: null, dir: 'asc' };

  document.querySelectorAll('th.sortable').forEach(th => {
    th.addEventListener('click', () => {
      const col = th.dataset.sort;
      const dir = currentSort.col === col && currentSort.dir === 'asc' ? 'desc' : 'asc';
      currentSort = { col, dir };

      // Update sort indicators
      document.querySelectorAll('th.sortable').forEach(h => {
        h.classList.remove('sorted');
        const arrow = h.querySelector('.sort-arrow');
        if (arrow) arrow.textContent = '↕';
      });
      th.classList.add('sorted');
      const arrow = th.querySelector('.sort-arrow');
      if (arrow) arrow.textContent = dir === 'asc' ? '▲' : '▼';

      // Sort rows
      const rows = Array.from(tbody.querySelectorAll('[data-machine-row]'));
      const sortKey = 'data-sort-' + col;
      rows.sort((a, b) => {
        let va = a.getAttribute(sortKey) || '';
        let vb = b.getAttribute(sortKey) || '';
        // Numeric sort for max, peak, expiry
        if (col === 'max' || col === 'peak' || col === 'expiry') {
          va = parseFloat(va); vb = parseFloat(vb);
          return dir === 'asc' ? va - vb : vb - va;
        }
        // Date sort for added
        if (col === 'added') {
          return dir === 'asc' ? va.localeCompare(vb) : vb.localeCompare(va);
        }
        // Status priority
        if (col === 'status') {
          const order = { online: 0, offline: 1, zombie: 2, expired: 3, revoked: 4 };
          va = order[va] ?? 9; vb = order[vb] ?? 9;
          return dir === 'asc' ? va - vb : vb - va;
        }
        // Tier priority
        if (col === 'tier') {
          const order = { unlimited: 0, pro: 1, basic: 2, trial: 3 };
          va = order[va] ?? 9; vb = order[vb] ?? 9;
          return dir === 'asc' ? va - vb : vb - va;
        }
        // Default text sort
        return dir === 'asc' ? va.localeCompare(vb) : vb.localeCompare(va);
      });

      // Re-append sorted rows
      rows.forEach(row => tbody.appendChild(row));
    });
  });

  // ═══════════════════════════════════════════════════════════════════════════
  // Sparkline rendering
  // ═══════════════════════════════════════════════════════════════════════════
  function renderSparkline(svg) {
    const raw = svg.dataset.sparkline;
    if (!raw) return;
    const pairs = raw.split(',').map(p => {
      const [ts, v] = p.split(':');
      return { ts: parseInt(ts), v: parseInt(v) };
    }).filter(p => !isNaN(p.v));
    if (pairs.length < 2) return;

    const maxPlayers = parseInt(svg.dataset.max) || 20;
    const maxVal = Math.max(maxPlayers, ...pairs.map(p => p.v));
    const minVal = 0;
    const w = 80, h = 28, pad = 2;
    const xScale = (i) => pad + (i / (pairs.length - 1)) * (w - 2 * pad);
    const yScale = (v) => h - pad - ((v - minVal) / (maxVal - minVal || 1)) * (h - 2 * pad);

    // Build polyline points
    const points = pairs.map((p, i) => xScale(i) + ',' + yScale(p.v)).join(' ');

    // Create SVG content
    let html = '';
    // Baseline at 0
    html += '<line x1="' + pad + '" y1="' + yScale(0) + '" x2="' + (w - pad) + '" y2="' + yScale(0) + '" stroke="#374151" stroke-width="0.5" stroke-dasharray="2,2"/>';
    // Max line
    html += '<line x1="' + pad + '" y1="' + yScale(maxPlayers) + '" x2="' + (w - pad) + '" y2="' + yScale(maxPlayers) + '" stroke="#374151" stroke-width="0.5" stroke-dasharray="1,3"/>';
    // Data line
    html += '<polyline points="' + points + '"/>';

    svg.innerHTML = html;
  }

  document.querySelectorAll('.sparkline-svg').forEach(renderSparkline);

  // ═══════════════════════════════════════════════════════════════════════════
  // Renew presets (single machine)
  // ═══════════════════════════════════════════════════════════════════════════
  function setRenewDays(days) {
    const input = document.getElementById('renewDaysInput');
    if (input) input.value = String(days);
    // Highlight active preset
    document.querySelectorAll('#renewOverlay .preset-btn').forEach(b => {
      b.style.borderColor = parseInt(b.textContent) === days ? 'var(--primary)' : 'var(--border)';
      b.style.color = parseInt(b.textContent) === days ? 'var(--primary)' : 'var(--text)';
    });
  }

  // ═══════════════════════════════════════════════════════════════════════════
  // Plan picker → fill form
  // ═══════════════════════════════════════════════════════════════════════════
  const planSel = document.getElementById('planPick');
  if (planSel) {
    planSel.addEventListener('change', () => {
      const opt = planSel.selectedOptions[0];
      if (!opt || !opt.value) return;
      const tier = opt.dataset.tier;
      const form = document.getElementById('addForm');
      form.querySelector(`input[name=tier][value="${tier}"]`).checked = true;
      updateTierUI(tier);
      if (opt.dataset.max)   form.querySelector('input[name=max_players]').value = opt.dataset.max;
      if (opt.dataset.trial && tier === 'trial')
        form.querySelector('input[name=trial_days]').value = opt.dataset.trial;
      const expDays = parseInt(opt.dataset.expdays);
      if (expDays > 0) {
        const d = new Date();
        d.setDate(d.getDate() + expDays);
        form.querySelector('input[name=expires_at]').value = d.toISOString().slice(0, 10);
      }
      if (opt.dataset.note)  form.querySelector('input[name=note]').value = opt.dataset.note;
    });
  }

  // ═══════════════════════════════════════════════════════════════════════════
  // Modal helpers
  // ═══════════════════════════════════════════════════════════════════════════
  const showOverlay = id => document.getElementById(id)?.classList.add('show');
  const hideOverlay = id => document.getElementById(id)?.classList.remove('show');

  const machineActions = {
    renew(btn) {
      const mid = btn.dataset.mid || '';
      document.getElementById('renewMid').value = mid;
      document.getElementById('renewMidLabel').textContent = mid;
      // Reset presets highlight
      document.querySelectorAll('#renewOverlay .preset-btn').forEach(b => {
        b.style.borderColor = 'var(--border)';
        b.style.color = 'var(--text)';
      });
      document.getElementById('renewDaysInput').value = '30';
      showOverlay('renewOverlay');
    },
    key(btn) {
      const mid = btn.dataset.mid || '';
      const currentKey = btn.dataset.licenseKey || '';
      document.getElementById('keyMid').value = mid;
      document.getElementById('keyMidRemove').value = mid;
      document.getElementById('keyMidLabel').textContent = mid;
      const cur = document.getElementById('keyCurrent');
      cur.textContent = currentKey || '— chưa có key —';
      cur.style.color = currentKey ? '#a5b4fc' : 'var(--muted)';
      showOverlay('keyOverlay');
    },
    transfer(btn) {
      const mid = btn.dataset.mid || '';
      document.getElementById('transferOldMid').value = mid;
      document.getElementById('transferOldLabel').textContent = mid;
      showOverlay('transferOverlay');
    },
  };

  document.addEventListener('click', event => {
    const actionBtn = event.target.closest('[data-machine-action]');
    if (actionBtn) {
      event.preventDefault();
      const handler = machineActions[actionBtn.dataset.machineAction];
      if (handler) handler(actionBtn);
      return;
    }

    const opener = event.target.closest('[data-modal-open]');
    if (opener) {
      event.preventDefault();
      showOverlay(opener.dataset.modalOpen);
      return;
    }

    const closer = event.target.closest('[data-modal-close]');
    if (closer) {
      event.preventDefault();
      hideOverlay(closer.dataset.modalClose);
    }
  });

  document.querySelectorAll('.overlay').forEach(ov => {
    ov.addEventListener('click', e => { if (e.target === ov) hideOverlay(ov.id); });
  });

  // ═══════════════════════════════════════════════════════════════════════════
  // WebSocket live updates — real-time status & player counts
  // ═══════════════════════════════════════════════════════════════════════════
  const wsProto = location.protocol === 'https:' ? 'wss:' : 'ws:';
  const wsUrl = wsProto + '//' + location.host + '/ws';
  let wsSocket = null, wsReconnect = null;

  function connectMachineWS() {
    if (wsSocket && wsSocket.readyState === WebSocket.OPEN) return;
    try { wsSocket = new WebSocket(wsUrl); } catch (e) { scheduleMachineWS(); return; }

    wsSocket.onopen = () => {
      const indicator = document.querySelector('.table-hint');
      if (indicator) indicator.innerHTML = indicator.innerHTML.replace(/.*/, '<span style="color:#34d399">● Live</span>');
    };

    wsSocket.onmessage = (event) => {
      try {
        const msg = JSON.parse(event.data);
        if (msg.event === 'init') {
          // Snapshot đầy đủ khi WS vừa connect — đồng bộ toàn bộ trạng thái
          const snapshot = Array.isArray(msg.data) ? msg.data : [];
          snapshot.forEach(function(srv) {
            if (srv && srv.mid) updateMachineRow(srv, 'online');
          });
        } else if (msg.event === 'machine.online') updateMachineRow(msg.data || msg, 'online');
        else if (msg.event === 'machine.offline') updateMachineRow(msg.data || msg, 'offline');
        else if (msg.event === 'machine.hb') updateMachineRow(msg.data || msg, 'hb');
      } catch (e) {}
    };

    wsSocket.onclose = () => { scheduleMachineWS(); };
    wsSocket.onerror = () => { wsSocket?.close(); };
  }

  function scheduleMachineWS() {
    if (wsReconnect) return;
    wsReconnect = setTimeout(() => { wsReconnect = null; connectMachineWS(); }, 5000);
  }

  function updateMachineRow(data, eventType) {
    if (!data || !data.mid) return;
    // Find row by MID
    const row = machineRows.find(r => {
      const code = r.querySelector('code');
      return code && code.textContent.trim() === data.mid;
    });
    if (!row) return;

    const statusCell = row.querySelector('td:nth-child(6)'); // Status column
    const peakCell = row.querySelector('td:nth-child(5)');   // Peak column

    if (eventType === 'online') {
      row.dataset.status = 'online';
      row.setAttribute('data-sort-status', 'online');
      // Update tier if provided
      if (data.tier) {
        row.dataset.tier = data.tier;
        row.setAttribute('data-sort-tier', data.tier);
      }
      if (statusCell) {
        const maxPl = data.max_players || parseInt(row.getAttribute('data-sort-max')) || 20;
        const players = data.players || 0;
        statusCell.innerHTML =
          '<span class="pill pill-green">● Online</span>' +
          '<div style="font-size:.72rem;color:var(--muted);margin-top:3px">' + players + '/' + maxPl + ' players</div>';
        // Restore sparkline opacity
        const svg = statusCell.querySelector('.sparkline-svg');
        if (svg) svg.style.opacity = '1';
      }
    } else if (eventType === 'offline') {
      row.dataset.status = 'offline';
      row.setAttribute('data-sort-status', 'offline');
      if (statusCell) {
        // Keep existing info but change pill
        const pill = statusCell.querySelector('.pill');
        if (pill) { pill.className = 'pill pill-gray'; pill.textContent = 'Offline'; }
        const svg = statusCell.querySelector('.sparkline-svg');
        if (svg) svg.style.opacity = '0.5';
      }
    } else if (eventType === 'hb') {
      const players = data.players || 0;
      const maxPl = data.max_players || parseInt(row.getAttribute('data-sort-max')) || 20;
      if (statusCell) {
        const playerDiv = statusCell.querySelector('div');
        if (playerDiv) playerDiv.textContent = players + '/' + maxPl + ' players';
        // Update sparkline — add new point
        const svg = statusCell.querySelector('.sparkline-svg');
        if (svg && svg.dataset.sparkline) {
          svg.dataset.sparkline += ',' + Date.now() + ':' + players;
          // Trim to last 48 points
          const parts = svg.dataset.sparkline.split(',');
          if (parts.length > 48) svg.dataset.sparkline = parts.slice(-48).join(',');
          renderSparkline(svg);
        }
      }
      if (peakCell && data.players > parseInt(peakCell.textContent || '0')) {
        peakCell.textContent = String(data.players);
        row.setAttribute('data-sort-peak', String(data.players));
      }
    }
  }

  connectMachineWS();
</script>
</body>
</html>
