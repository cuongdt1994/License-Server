<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Settings — License Manager</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
  <style>
    :root { --bg:#111827; --surface:#1f2937; --border:#374151; --text:#f9fafb; --muted:#9ca3af; --primary:#6366f1; }
    * { box-sizing: border-box; }
    body    { background: radial-gradient(circle at top left, #172033 0, var(--bg) 34%); color: var(--text); font-family: 'Segoe UI', sans-serif; margin: 0; min-height: 100vh; }
    .topbar { background: var(--surface); border-bottom: 1px solid var(--border);
              padding: 12px 24px; display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap; position: sticky; top: 0; z-index: 20; }
    .topbar-brand { font-weight: 700; font-size: 1.1rem; display: flex; align-items: center; gap: 8px; }
    .topbar-brand i { color: var(--primary); font-size: 1.3rem; }
    .nav-btns { overflow-x: auto; max-width: 100%; padding-bottom: 2px; }
    .nav-btns a { color: #d1d5db; text-decoration: none; padding: 6px 14px;
                  border-radius: 6px; font-size: .875rem; transition: background .15s; }
    .nav-btns a:hover      { background: var(--border); color: #fff; }
    .nav-btns a.active     { background: var(--primary); color: #fff; }
    .nav-btns a.btn-logout { color: #f87171; border: 1px solid #f87171; }
    .nav-btns a.btn-logout:hover { background: #f87171; color: #fff; }
    .page   { padding: 24px; max-width: 1120px; margin: 0 auto; }
    .page-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 18px; margin-bottom: 18px; }
    .eyebrow { color: #93c5fd; font-size: .76rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; margin-bottom: 6px; }
    .page-title { margin: 0; font-size: 1.35rem; line-height: 1.2; font-weight: 800; }
    .page-sub { margin-top: 6px; color: var(--muted); font-size: .875rem; }
    .flash  { padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; font-size: .875rem; display: flex; align-items: center; gap: 10px; }
    .flash-success { background: #064e3b; color: #6ee7b7; border: 1px solid #065f46; }
    .flash-danger  { background: #7f1d1d; color: #fca5a5; border: 1px solid #991b1b; }
    .section { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 24px; margin-bottom: 20px; }
    .section-title { font-size: 1rem; font-weight: 700; margin-bottom: 18px; display: flex; align-items: center; gap: 8px; }
    .section-title i { color: var(--primary); }
    .form-group { margin-bottom: 14px; }
    .form-group label { display: block; font-size: .78rem; font-weight: 600; color: var(--muted);
                        text-transform: uppercase; letter-spacing: .05em; margin-bottom: 5px; }
    .form-group input, .form-group textarea, .form-group select {
      width: 100%; background: #161e2e; color: var(--text); border: 1px solid var(--border);
      border-radius: 8px; padding: 9px 12px; font-size: .875rem; outline: none; resize: vertical; }
    .form-group input:focus, .form-group textarea:focus, .form-group select:focus { border-color: var(--primary); }
    .form-group .hint { font-size: .73rem; color: var(--muted); margin-top: 4px; }
    .btn-primary { background: var(--primary); color: #fff; border: none; padding: 9px 20px;
                   border-radius: 8px; font-size: .875rem; font-weight: 600; cursor: pointer; }
    .btn-primary:hover { opacity: .85; }
    .btn-outline { background: transparent; color: var(--muted); border: 1px solid var(--border);
                   padding: 8px 18px; border-radius: 8px; font-size: .875rem; cursor: pointer; }
    .btn-outline:hover { background: var(--border); color: var(--text); }
    .btn-danger  { background: #7f1d1d; color: #f87171; border: 1px solid #991b1b;
                   padding: 9px 20px; border-radius: 8px; font-size: .875rem; cursor: pointer; }
    .btn-danger:hover { background: #991b1b; color: #fff; }
    .status-badge { display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px;
                    border-radius: 999px; font-size: .8rem; font-weight: 700; margin-bottom: 14px; }
    .badge-on  { background: #064e3b; color: #34d399; }
    .badge-off { background: #374151; color: #9ca3af; }
    code { background: #161e2e; color: #a5b4fc; padding: 2px 6px; border-radius: 4px; font-size: .8rem; }
    .divider { display: flex; align-items: center; gap: 12px; margin: 18px 0; }
    .divider hr { flex: 1; border: none; border-top: 1px solid var(--border); }
    .divider span { font-size: .75rem; color: var(--muted); white-space: nowrap; }
    .btn-row { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
    .runtime-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
    .runtime-item { background: #161e2e; border: 1px solid var(--border); border-radius: 8px; padding: 12px; min-width: 0; }
    .runtime-label { color: var(--muted); font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; margin-bottom: 7px; }
    .runtime-value { color: var(--text); font-size: .84rem; overflow-wrap: anywhere; }
    .runtime-value code { display: inline-block; max-width: 100%; overflow-wrap: anywhere; }
    .callout { display: flex; gap: 10px; align-items: flex-start; border: 1px solid #1d4ed8; background: rgba(29,78,216,.12); color: #bfdbfe; border-radius: 8px; padding: 12px; font-size: .82rem; margin-top: 14px; }
    @media (max-width: 820px) {
      .runtime-grid { grid-template-columns: 1fr; }
      .page-head { display: block; }
    }
  </style>
</head>
<body>

<div class="topbar">
  <div class="topbar-brand"><i class="bi bi-shield-lock-fill"></i>License Manager</div>
  <div class="nav-btns d-flex gap-1">
    <a href="/">Dashboard</a>
    <a href="/machines">Machines</a>
    <a href="/plans">Plans</a>
    <a href="/bans">IP Bans</a>
    <a href="/history">History</a>
    <a href="/logs">Logs</a>
    <a href="/settings" class="active">Settings</a>
    <a href="/logout" class="btn-logout">Logout</a>
  </div>
</div>

<div class="page">

  <%- include('partials/flash-toast', { flash: flash }) %>

  <div class="page-head">
    <div>
      <div class="eyebrow">System settings</div>
      <h1 class="page-title">License Manager Control Center</h1>
      <div class="page-sub">Runtime storage, notifications, command safety, and account protection.</div>
    </div>
  </div>

  <!-- Runtime storage -->
  <div class="section">
    <div class="section-title"><i class="bi bi-database-check"></i>Runtime Storage</div>
    <div class="runtime-grid">
      <div class="runtime-item">
        <div class="runtime-label">Active data dir</div>
        <div class="runtime-value"><code><%= dataDir || 'unknown' %></code></div>
      </div>
      <div class="runtime-item">
        <div class="runtime-label">Source</div>
        <div class="runtime-value"><code><%= dataDirSource || 'unknown' %></code></div>
      </div>
      <div class="runtime-item">
        <div class="runtime-label">Remember file</div>
        <div class="runtime-value"><code><%= dataDirLocalFile || 'data_dir.local' %></code></div>
      </div>
    </div>
    <div class="callout">
      <i class="bi bi-info-circle-fill"></i>
      <div>
        To make the server remember a storage path without exporting env vars, put one absolute path in <code>data_dir.local</code>, then restart the screen session. <code>LICENSE_DATA_DIR</code> still has priority when it is set.
      </div>
    </div>
  </div>

  <!-- Telegram -->
  <div class="section">
    <div class="section-title"><i class="bi bi-telegram"></i>Telegram Notifications</div>
    <% if (settings.telegram_token) { %>
      <div class="status-badge badge-on"><i class="bi bi-check-circle-fill"></i>Đã cấu hình</div>
    <% } else { %>
      <div class="status-badge badge-off"><i class="bi bi-x-circle"></i>Chưa cấu hình</div>
    <% } %>
    <form method="POST" action="/settings/telegram">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-group">
        <label>Bot Token</label>
        <input name="telegram_token" value="<%= settings.telegram_token || '' %>"
               placeholder="1234567890:AABBccDDeeFFggHHiiJJ...">
        <div class="hint">Lấy từ @BotFather trên Telegram</div>
      </div>
      <div class="form-group">
        <label>Chat ID</label>
        <input name="telegram_chat_id" value="<%= settings.telegram_chat_id || '' %>"
               placeholder="-1001234567890">
        <div class="hint">Chat ID của bạn hoặc group. Dùng @userinfobot để lấy.</div>
      </div>
      <div class="btn-row">
        <button type="submit" class="btn-primary"><i class="bi bi-save me-1"></i>Lưu</button>
        <% if (settings.telegram_token) { %>
        <button type="submit" form="testTgForm" class="btn-outline">
          <i class="bi bi-send me-1"></i>Gửi test
        </button>
        <% } %>
      </div>
    </form>
    <form id="testTgForm" method="POST" action="/settings/test-telegram">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    </form>
  </div>

  <!-- Webhook -->
  <div class="section">
    <div class="section-title"><i class="bi bi-arrow-repeat"></i>Webhook URLs</div>
    <p style="font-size:.82rem;color:var(--muted);margin-bottom:14px">
      Khi có event (online/offline/revoke/expire...) → POST JSON đến các URL này.<br>
      Dùng để tích hợp với n8n, Make.com, hoặc hệ thống billing tự viết.
    </p>
    <form method="POST" action="/settings/webhook">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-group">
        <label>Webhook URLs (mỗi dòng 1 URL)</label>
        <textarea name="webhooks" rows="4" placeholder="https://hooks.example.com/license&#10;https://n8n.example.com/webhook/abc"><%= (settings.webhooks || []).join('\n') %></textarea>
        <div class="hint">Chỉ hỗ trợ HTTP/HTTPS. POST JSON: <code>{ event, data, ts }</code></div>
      </div>
      <button type="submit" class="btn-primary"><i class="bi bi-save me-1"></i>Lưu</button>
    </form>
  </div>

  <!-- Agent command safety -->
  <div class="section">
    <div class="section-title"><i class="bi bi-terminal"></i>Agent Command Safety</div>
    <form method="POST" action="/settings/agent">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-group">
        <label>Advanced shell</label>
        <select name="advanced_shell_enabled">
          <option value="1" <%= settings.advanced_shell_enabled === false ? '' : 'selected' %>>Enabled</option>
          <option value="0" <%= settings.advanced_shell_enabled === false ? 'selected' : '' %>>Disabled</option>
        </select>
        <div class="hint">Safe actions continue working even when advanced shell is disabled.</div>
      </div>
      <div class="form-group">
        <label>Default shell timeout (seconds)</label>
        <input type="number" name="agent_shell_timeout" min="5" max="300" value="<%= settings.agent_shell_timeout || 120 %>">
        <div class="hint">Commands are clamped between 5 and 300 seconds.</div>
      </div>
      <button type="submit" class="btn-primary"><i class="bi bi-save me-1"></i>Save</button>
    </form>
  </div>

  <!-- 2FA -->
  <div class="section">
    <div class="section-title"><i class="bi bi-shield-check"></i>Two-Factor Authentication (TOTP)</div>
    <% if (settings.totp_enabled) { %>
      <div class="status-badge badge-on"><i class="bi bi-shield-lock-fill"></i>2FA đang BẬT</div>
      <p style="font-size:.82rem;color:var(--muted);margin-bottom:14px">
        Mỗi lần đăng nhập cần nhập mã 6 chữ số từ Google Authenticator / Authy.
      </p>
      <div class="btn-row">
        <form method="POST" action="/settings/disable-2fa"
              onsubmit="return confirm('Tắt 2FA? Đăng nhập sẽ chỉ cần username/password.')">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn-danger"><i class="bi bi-shield-x me-1"></i>Tắt 2FA</button>
        </form>
      </div>
    <% } else { %>
      <div class="status-badge badge-off"><i class="bi bi-shield-slash"></i>2FA đang TẮT</div>
      <p style="font-size:.82rem;color:var(--muted);margin-bottom:14px">
        Bật 2FA để bảo vệ tài khoản admin bằng Google Authenticator hoặc Authy.
      </p>
      <a href="/settings/setup-2fa" class="btn-primary" style="display:inline-block;text-decoration:none">
        <i class="bi bi-shield-lock me-1"></i>Bật 2FA
      </a>
    <% } %>
  </div>

  <!-- Danger zone -->
  <div class="section" style="border-color:#7f1d1d">
    <div class="section-title" style="color:#f87171"><i class="bi bi-exclamation-triangle"></i>Khác</div>
    <div class="btn-row">
      <a href="/export/csv" class="btn-outline" style="text-decoration:none">
        <i class="bi bi-download me-1"></i>Export CSV tất cả license
      </a>
      <a href="/import" class="btn-outline" style="text-decoration:none">
        <i class="bi bi-upload me-1"></i>Import CSV
      </a>
      <a href="/health" target="_blank" class="btn-outline" style="text-decoration:none">
        <i class="bi bi-heart-pulse me-1"></i>Health check
      </a>
      <a href="/portal" target="_blank" class="btn-outline" style="text-decoration:none">
        <i class="bi bi-person-badge me-1"></i>Customer Portal
      </a>
    </div>
  </div>

</div>
</body>
</html>
