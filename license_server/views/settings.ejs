<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Settings — License Manager</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
</head>
<body>

<%- include('partials/topbar', { activePage: 'settings' }) %>

<div class="page page-md">

  <% if (typeof flash !== 'undefined' && flash) { %>
  <div class="alert alert-<%= flash.type %>">
    <% if (flash.type === 'success') { %>✅<% } else { %>⚠️<% } %>
    <span><%= flash.msg %></span>
    <button class="alert-close" onclick="this.parentElement.remove()">×</button>
  </div>
  <% } %>

  <div class="page-head">
    <div>
      <div class="page-eyebrow">System configuration</div>
      <h1 class="page-title">Settings</h1>
      <p class="page-sub">Cấu hình runtime, thông báo, bảo mật và bảo trì hệ thống.</p>
    </div>
  </div>

  <!-- ── Maintenance mode ── -->
  <div class="section" style="<%= settings.maintenance ? 'border-color:#f59e0b' : '' %>">
    <div class="section-title">🔧 Maintenance Mode</div>
    <% if (settings.maintenance) { %>
      <div class="alert alert-warning" style="margin-bottom:14px">
        🔧 <span><b>Đang BẬT</b> — Tất cả AUTH/HB từ game server đều bị từ chối.
        <% if (settings.maintenance_until) { %>
          Tự động tắt lúc <b><%= new Date(settings.maintenance_until).toLocaleString('vi-VN') %></b>.
        <% } else { %>
          <b>Vô thời hạn</b>.
        <% } %>
        </span>
      </div>
    <% } else { %>
      <p class="text-sm text-muted mb-3">Bật chế độ bảo trì để từ chối mọi kết nối AUTH/HB từ game server (dùng khi deploy, sửa lỗi, nâng cấp).</p>
    <% } %>
    <div class="flex gap-2 flex-wrap">
      <form method="POST" action="/maintenance" class="flex gap-2 items-center">
        <input type="hidden" name="action" value="<%= settings.maintenance ? 'off' : 'on' %>">
        <% if (!settings.maintenance) { %>
        <input type="number" name="minutes" placeholder="Phút (0=vô hạn)" min="0" max="1440" value="30"
               class="form-input" style="width:120px">
        <% } %>
        <button type="submit" class="btn <%= settings.maintenance ? 'btn-success' : 'btn-warning' %>">
          <%= settings.maintenance ? '🟢 TẮT Maintenance' : '🔧 BẬT Maintenance' %>
        </button>
      </form>
    </div>
  </div>

  <!-- ── Runtime Storage ── -->
  <div class="section">
    <div class="section-title">💾 Runtime Storage</div>
    <div class="stat-grid" style="grid-template-columns: repeat(3, 1fr)">
      <div class="stat-card" style="--accent:#6366f1">
        <div class="stat-label">Active data dir</div>
        <div class="stat-value text-sm font-mono" style="font-size:.82rem;overflow-wrap:anywhere"><%= dataDir || 'unknown' %></div>
      </div>
      <div class="stat-card" style="--accent:#22c55e">
        <div class="stat-label">Source</div>
        <div class="stat-value text-sm" style="font-size:.82rem"><%= dataDirSource || 'unknown' %></div>
      </div>
      <div class="stat-card" style="--accent:#8b5cf6">
        <div class="stat-label">Remember file</div>
        <div class="stat-value text-sm font-mono" style="font-size:.78rem"><%= typeof dataDirLocalFile !== 'undefined' ? dataDirLocalFile : 'data_dir.local' %></div>
      </div>
    </div>
    <div class="alert alert-info" style="margin-top:12px">
      ℹ️ <span>Để ghi nhớ data dir không cần env, đặt đường dẫn tuyệt đối trong <code>data_dir.local</code> rồi restart. <code>LICENSE_DATA_DIR</code> vẫn ưu tiên cao nhất.</span>
    </div>
  </div>

  <!-- ── Runtime Status ── -->
  <div class="section">
    <div class="section-title">📡 Runtime Status</div>
    <div class="stat-grid" style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr))">
      <div class="stat-card" style="--accent:#6366f1">
        <div class="stat-label">Web UI</div>
        <div class="stat-value text-sm font-mono" style="font-size:.82rem"><code><%= runtime.bindHost %>:<%= runtime.webPort %></code></div>
      </div>
      <div class="stat-card" style="--accent:#22c55e">
        <div class="stat-label">TCP License</div>
        <div class="stat-value text-sm font-mono" style="font-size:.82rem"><code><%= runtime.bindHost %>:<%= runtime.tcpPort %></code></div>
      </div>
      <div class="stat-card" style="--accent:#f59e0b">
        <div class="stat-label">Node Env</div>
        <div class="stat-value text-sm" style="font-size:.82rem"><%= runtime.nodeEnv %></div>
      </div>
      <div class="stat-card" style="--accent:#8b5cf6">
        <div class="stat-label">PM2</div>
        <div class="stat-value text-sm" style="font-size:.82rem">
          <% if (runtime.pm2 && runtime.pm2.enabled) { %>
            <span class="badge badge-success">Online</span>
            <% if (runtime.pm2.name) { %><div class="mt-2 text-xs text-muted"><%= runtime.pm2.name %><% if (runtime.pm2.id) { %> #<%= runtime.pm2.id %><% } %></div><% } %>
          <% } else { %>
            <span class="badge badge-muted">Not PM2</span>
          <% } %>
        </div>
      </div>
      <div class="stat-card" style="--accent:#0ea5e9">
        <div class="stat-label">Session Secret</div>
        <div class="stat-value text-sm" style="font-size:.78rem"><code><%= runtime.secretSources && runtime.secretSources.session || 'unknown' %></code></div>
      </div>
      <div class="stat-card" style="--accent:#ef4444">
        <div class="stat-label">TCP Secret</div>
        <div class="stat-value text-sm" style="font-size:.78rem"><code><%= runtime.secretSources && runtime.secretSources.tcp || 'unknown' %></code></div>
      </div>
      <div class="stat-card" style="--accent:#22c55e">
        <div class="stat-label">Secret File</div>
        <div class="stat-value text-sm" style="font-size:.78rem"><code><%= runtime.secretFile || 'env only' %></code></div>
      </div>
    </div>
    <% if (runtimeWarnings && runtimeWarnings.length) { %>
      <% runtimeWarnings.forEach(function(w) { %>
        <div class="alert alert-warning" style="margin-top:10px">⚠️ <span><%= w %></span></div>
      <% }) %>
    <% } %>
  </div>

  <!-- ── Telegram ── -->
  <div class="section">
    <div class="section-title">✈️ Telegram Notifications</div>
    <% if (settings.telegram_token) { %>
      <span class="badge badge-success" style="margin-bottom:14px">✅ Đã cấu hình</span>
    <% } else { %>
      <span class="badge badge-muted" style="margin-bottom:14px">⭕ Chưa cấu hình</span>
    <% } %>
    <form method="POST" action="/settings/telegram">
      <div class="form-group">
        <label class="form-label">Bot Token</label>
        <input name="telegram_token" class="form-input" value="<%= settings.telegram_token || '' %>" placeholder="1234567890:AABBccDDeeFFggHHiiJJ...">
        <div class="form-hint">Lấy từ @BotFather trên Telegram</div>
      </div>
      <div class="form-group">
        <label class="form-label">Chat ID</label>
        <input name="telegram_chat_id" class="form-input" value="<%= settings.telegram_chat_id || '' %>" placeholder="-1001234567890">
        <div class="form-hint">Chat ID của bạn hoặc group. Dùng @userinfobot để lấy.</div>
      </div>
      <div class="flex gap-2">
        <button type="submit" class="btn btn-primary">💾 Lưu</button>
        <% if (settings.telegram_token) { %>
        <button type="submit" form="testTgForm" class="btn btn-outline">📨 Gửi test</button>
        <% } %>
      </div>
    </form>
    <form id="testTgForm" method="POST" action="/settings/test-telegram"></form>
  </div>

  <!-- ── Webhooks ── -->
  <div class="section">
    <div class="section-title">🔗 Webhook URLs</div>
    <p class="text-sm text-muted mb-3">Khi có event (online/offline/revoke/expire...) → POST JSON đến các URL này. Dùng để tích hợp n8n, Make.com, hoặc billing.</p>
    <form method="POST" action="/settings/webhook">
      <div class="form-group">
        <label class="form-label">Webhook URLs (mỗi dòng 1 URL)</label>
        <textarea name="webhooks" class="form-textarea" rows="4" placeholder="https://hooks.example.com/license&#10;https://n8n.example.com/webhook/abc"><%= (settings.webhooks || []).join('\n') %></textarea>
        <div class="form-hint">POST JSON: <code>{ event, data, ts }</code></div>
      </div>
      <button type="submit" class="btn btn-primary">💾 Lưu</button>
    </form>
  </div>

  <!-- ── Agent Safety ── -->
  <div class="section">
    <div class="section-title">🛡️ Agent Command Safety</div>
    <form method="POST" action="/settings/agent">
      <div class="form-group">
        <label class="form-label">Advanced Shell</label>
        <select name="advanced_shell_enabled" class="form-select">
          <option value="1" <%= settings.advanced_shell_enabled === true ? 'selected' : '' %>>Enabled</option>
          <option value="0" <%= settings.advanced_shell_enabled === true ? '' : 'selected' %>>Disabled</option>
        </select>
        <div class="form-hint">Safe actions vẫn hoạt động ngay cả khi advanced shell bị tắt.</div>
      </div>
      <div class="form-group">
        <label class="form-label">Default Shell Timeout (seconds)</label>
        <input type="number" name="agent_shell_timeout" min="5" max="300" value="<%= settings.agent_shell_timeout || 120 %>" class="form-input" style="width:140px">
        <div class="form-hint">Commands are clamped between 5 and 300 seconds.</div>
      </div>
      <button type="submit" class="btn btn-primary">💾 Save</button>
    </form>
  </div>

  <!-- ── Change Password ── -->
  <div class="section">
    <div class="section-title">🔑 Đổi mật khẩu Admin</div>
    <p class="text-sm text-muted mb-3">Mật khẩu cần ít nhất 10 ký tự, có chữ hoa, chữ thường và số.</p>
    <form method="POST" action="/settings/change-password">
      <div class="form-group">
        <label class="form-label">Mật khẩu hiện tại</label>
        <input type="password" name="current_password" class="form-input" required autocomplete="current-password" placeholder="Nhập mật khẩu hiện tại">
      </div>
      <div class="form-group">
        <label class="form-label">Mật khẩu mới</label>
        <input type="password" name="new_password" class="form-input" required autocomplete="new-password" placeholder="Ít nhất 10 ký tự, có chữ hoa, chữ thường, số" minlength="10">
      </div>
      <div class="form-group">
        <label class="form-label">Xác nhận mật khẩu mới</label>
        <input type="password" name="confirm_password" class="form-input" required autocomplete="new-password" placeholder="Nhập lại mật khẩu mới">
      </div>
      <button type="submit" class="btn btn-danger">🔒 Đổi mật khẩu</button>
    </form>
  </div>

  <!-- ── 2FA ── -->
  <div class="section">
    <div class="section-title">🔐 Two-Factor Authentication (TOTP)</div>
    <% if (settings.totp_enabled) { %>
      <span class="badge badge-success" style="margin-bottom:10px">🛡️ 2FA đang BẬT</span>
      <p class="text-sm text-muted mb-3">Mỗi lần đăng nhập cần mã 6 chữ số từ Google Authenticator / Authy.</p>
      <form method="POST" action="/settings/disable-2fa" onsubmit="return confirm('Tắt 2FA? Đăng nhập sẽ chỉ cần username/password.')">
        <button type="submit" class="btn btn-danger">🔓 Tắt 2FA</button>
      </form>
    <% } else { %>
      <span class="badge badge-muted" style="margin-bottom:10px">⭕ 2FA đang TẮT</span>
      <p class="text-sm text-muted mb-3">Bật 2FA để bảo vệ tài khoản admin bằng Google Authenticator hoặc Authy.</p>
      <a href="/settings/setup-2fa" class="btn btn-primary">🔐 Bật 2FA</a>
    <% } %>
  </div>

  <!-- ── Quick Links ── -->
  <div class="section" style="border-color:#374151">
    <div class="section-title" style="color:#94a3b8">📎 Quick Links</div>
    <div class="flex gap-2 flex-wrap">
      <a href="/export/csv" class="btn btn-outline btn-sm">📥 Export CSV</a>
      <a href="/import" class="btn btn-outline btn-sm">📤 Import CSV</a>
      <a href="/health" target="_blank" class="btn btn-outline btn-sm">💚 Health Check</a>
      <a href="/portal" target="_blank" class="btn btn-outline btn-sm">🌐 Customer Portal</a>
    </div>
  </div>

</div>

</body>
</html>
