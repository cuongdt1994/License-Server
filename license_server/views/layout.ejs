<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>License Manager</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
  <style>
    :root { --bg:#111827; --surface:#1f2937; --border:#374151; --text:#f9fafb; --muted:#9ca3af; --primary:#6366f1; }
    body            { background: radial-gradient(circle at top left, #172033 0, var(--bg) 34%); color: var(--text); min-height: 100vh; }
    .navbar         { background: var(--surface) !important; border-bottom: 1px solid var(--border); }
    .card           { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; }
    .table          { color: #e0e0e0; }
    .table-dark td,
    .table-dark th  { background: #1a1d27; border-color: #2d3147; color: #e0e0e0; }
    .modal-content  { background: #1a1d27; border: 1px solid #2d3147; }
    .modal-header,
    .modal-footer   { border-color: #2d3147 !important; }
    .form-control,
    .form-select    { background: #12141c !important; color: #e0e0e0 !important;
                      border-color: #2d3147 !important; }
    .form-control:focus { box-shadow: 0 0 0 .2rem rgba(124,106,247,.25); }
    pre             { background: #12141c; color: #a8ff78; font-size: .75rem;
                      border-radius: 6px; padding: 14px;
                      max-height: 420px; overflow-y: auto; white-space: pre-wrap; }
    .nav-link.active { color: #fff !important; }
    .btn { border-radius: 8px; }
  </style>
</head>
<body>

<!-- Navbar -->
<nav class="navbar navbar-dark px-3 mb-4">
  <span class="navbar-brand fw-bold">
    <i class="bi bi-shield-lock-fill me-2 text-primary"></i>License Manager
  </span>
  <div class="d-flex gap-2">
    <a href="/"         class="btn btn-sm btn-outline-secondary"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a>
    <a href="/machines" class="btn btn-sm btn-outline-secondary"><i class="bi bi-hdd-stack me-1"></i>Machines</a>
    <a href="/plans"    class="btn btn-sm btn-outline-secondary"><i class="bi bi-layers me-1"></i>Plans</a>
    <a href="/operations" class="btn btn-sm btn-outline-secondary"><i class="bi bi-activity me-1"></i>Operations</a>
    <a href="/bans"     class="btn btn-sm btn-outline-secondary"><i class="bi bi-shield-x me-1"></i>IP Bans</a>
    <a href="/history"  class="btn btn-sm btn-outline-secondary"><i class="bi bi-clock-history me-1"></i>History</a>
    <a href="/logs"     class="btn btn-sm btn-outline-secondary"><i class="bi bi-terminal me-1"></i>Logs</a>
    <a href="/settings" class="btn btn-sm btn-outline-secondary"><i class="bi bi-sliders me-1"></i>Settings</a>
    <a href="/logout"   class="btn btn-sm btn-outline-danger"><i class="bi bi-box-arrow-right me-1"></i>Logout</a>
  </div>
</nav>

<!-- Content -->
<div class="container-fluid px-4">

  <!-- Flash message -->
  <% if (typeof flash !== 'undefined' && flash) { %>
  <div class="alert alert-<%= flash.type %> alert-dismissible fade show">
    <%= flash.msg %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
  <% } %>

  <%- body %>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<% if (typeof csrfToken !== 'undefined') { %>
<script>
(() => {
  const token = <%- JSON.stringify(csrfToken) %>;
  document.querySelectorAll('form[method="POST"], form[method="post"]').forEach(form => {
    if (!form.querySelector('input[name="_csrf"]')) {
      const input = document.createElement('input');
      input.type = 'hidden';
      input.name = '_csrf';
      input.value = token;
      form.appendChild(input);
    }
  });
})();
</script>
<% } %>
<%- typeof scripts !== 'undefined' ? scripts : '' %>
</body>
</html>
