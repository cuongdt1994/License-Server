<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Import — License Manager</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
</head>
<body>
<%- include('partials/topbar', { activePage: '' }) %>
<div class="page page-sm">

  <% if (typeof flash !== 'undefined' && flash) { %>
  <div class="alert alert-<%= flash.type %>">
    <% if (flash.type === 'success') { %>✅<% } else { %>⚠️<% } %>
    <span><%= flash.msg %></span>
    <button class="alert-close" onclick="this.parentElement.remove()">×</button>
  </div>
  <% } %>

  <div class="page-head">
    <div>
      <div class="page-eyebrow">Data</div>
      <h1 class="page-title">Import CSV</h1>
      <p class="page-sub">Nhập danh sách license từ file CSV.</p>
    </div>
    <a href="/machines" class="btn btn-outline btn-sm">🖥 Machines</a>
  </div>

  <% if (typeof result !== 'undefined' && result) { %>
    <% if (result.error) { %>
      <div class="alert alert-danger">❌ <%= result.error %></div>
    <% } else { %>
      <div class="alert alert-success">
        ✅ Đã import <b><%= result.added %></b> license, bỏ qua <b><%= result.skipped %></b>.
        <% if (result.errors && result.errors.length) { %><div class="mt-2 text-sm"><%= result.errors.join('<br>') %></div><% } %>
      </div>
    <% } %>
  <% } %>

  <div class="card">
    <div class="card-title mb-3">📤 Upload CSV</div>
    <form method="POST" action="/import" enctype="multipart/form-data">
      <div class="form-group">
        <label class="form-label">File CSV</label>
        <input type="file" name="csvfile" accept=".csv,.txt" class="form-input" required>
        <div class="form-hint">
          Format: <code>machine_id,tier,max_players,note,expires_at</code><br>
          Dòng bắt đầu bằng <code>#</code> hoặc <code>machine_id</code> sẽ bị bỏ qua.
        </div>
      </div>
      <button type="submit" class="btn btn-primary">📤 Upload & Import</button>
    </form>
  </div>

  <div class="card">
    <div class="card-title mb-3">📋 Ví dụ CSV</div>
    <pre style="background:var(--panel);border:1px solid var(--border);border-radius:var(--radius-sm);padding:14px;font-size:.78rem;color:#a5b4fc;margin:0">machine_id,tier,max_players,note,expires_at
aa:bb:cc:dd:ee:ff|server1,basic,20,Anh Tuan,2025-12-31
aa:bb:cc:dd:ee:ff|server2,pro,50,Chi Nga,
aa:bb:cc:dd:ee:ff|server3,trial,10,Dung thu,
aa:bb:cc:dd:ee:ff|server4,unlimited,9999,VIP,</pre>
  </div>
</div>
</body>
</html>
