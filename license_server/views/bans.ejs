<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>IP Bans — License Manager</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
</head>
<body>
<%- include('partials/topbar', { activePage: 'bans' }) %>
<div class="page page-md">

  <% if (typeof flash !== 'undefined' && flash) { %>
  <div class="alert alert-<%= flash.type %>">
    <% if (flash.type === 'success') { %>✅<% } else { %>⚠️<% } %>
    <span><%= flash.msg %></span>
    <button class="alert-close" onclick="this.parentElement.remove()">×</button>
  </div>
  <% } %>

  <div class="page-head">
    <div>
      <div class="page-eyebrow">Security</div>
      <h1 class="page-title">IP Bans</h1>
      <p class="page-sub">Quản lý IP/range bị cấm kết nối TCP license.</p>
    </div>
  </div>

  <div class="card">
    <div class="card-title mb-3">➕ Thêm IP Ban</div>
    <form method="POST" action="/ban-add" class="flex gap-2 items-end flex-wrap">
      <div class="form-group" style="margin:0;flex:1;min-width:200px">
        <label class="form-label">IP hoặc Range</label>
        <input name="range" class="form-input" placeholder="VD: 1.2.3.4 hoặc 10.0.0.0/24 hoặc 1.2.3.*" required>
      </div>
      <div class="form-group" style="margin:0;flex:2;min-width:200px">
        <label class="form-label">Ghi chú</label>
        <input name="note" class="form-input" placeholder="Lý do ban">
      </div>
      <button type="submit" class="btn btn-danger">🚫 Ban</button>
    </form>
  </div>

  <div class="card" style="padding:0;overflow:hidden">
    <div class="card-header" style="padding:16px 20px">
      <div class="card-title" style="margin:0">🚫 Danh sách IP Ban</div>
      <div class="card-sub"><%= rows.length %> entries</div>
    </div>
    <% if (rows.length === 0) { %>
    <div class="empty"><i>🛡️</i><p>Chưa có IP nào bị ban</p></div>
    <% } else { %>
    <div class="table-wrap" style="border:none;border-radius:0">
    <table>
      <thead><tr><th>IP / Range</th><th>Ghi chú</th><th>Ngày thêm</th><th>Trạng thái</th><th>Actions</th></tr></thead>
      <tbody>
        <% rows.forEach(function(r) { var range=r[0], info=r[1]; %>
        <tr>
          <td class="font-mono"><%= range %></td>
          <td class="text-sm text-muted"><%= info.note || '—' %></td>
          <td class="text-xs text-muted"><%= info.added %></td>
          <td>
            <% if (info.disabled) { %><span class="badge badge-muted">Disabled</span>
            <% } else { %><span class="badge badge-danger">Active</span><% } %>
            <% if (info.expires_at) { %><div class="text-xs text-muted mt-2">Hết hạn: <%= new Date(info.expires_at).toLocaleString('vi-VN') %></div><% } %>
          </td>
          <td>
            <div class="flex gap-2">
              <form method="POST" action="/ban-toggle" style="display:inline">
                <input type="hidden" name="range" value="<%= range %>">
                <button type="submit" class="btn btn-outline btn-xs"><%= info.disabled ? 'Enable' : 'Disable' %></button>
              </form>
              <form method="POST" action="/ban-delete" style="display:inline" onsubmit="return confirm('Xóa ban <%= range %>?')">
                <input type="hidden" name="range" value="<%= range %>">
                <button type="submit" class="btn btn-danger btn-xs">🗑 Xóa</button>
              </form>
            </div>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    </div>
    <% } %>
  </div>
</div>
</body>
</html>
