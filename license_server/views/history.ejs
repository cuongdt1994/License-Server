<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>History — License Manager</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
</head>
<body>
<%- include('partials/topbar', { activePage: 'history' }) %>
<div class="page">

  <div class="page-head">
    <div>
      <div class="page-eyebrow">Event log</div>
      <h1 class="page-title">Lịch sử hoạt động</h1>
      <p class="page-sub">Online, offline, revoke, transfer và các sự kiện khác.</p>
    </div>
    <div class="flex gap-2">
      <% if (typeof filter_mid !== 'undefined' && filter_mid) { %>
      <a href="/history" class="btn btn-outline btn-sm">✕ Clear filter</a>
      <% } %>
      <a href="/logs" class="btn btn-outline btn-sm">📝 Logs</a>
    </div>
  </div>

  <% if (typeof filter_mid !== 'undefined' && filter_mid) { %>
  <div class="alert alert-info">🔍 Đang lọc: <code><%= filter_mid %></code> — <a href="/history" style="color:inherit">xóa filter</a></div>
  <% } %>

  <div class="card" style="padding:0;overflow:hidden">
    <div class="card-header" style="padding:16px 20px">
      <div class="card-title" style="margin:0">📜 Events <span class="text-muted text-sm">(<%= events.length %> gần nhất)</span></div>
    </div>
    <% if (events.length === 0) { %>
    <div class="empty"><i>📜</i><p>Chưa có sự kiện nào</p></div>
    <% } else { %>
    <div class="table-wrap" style="border:none;border-radius:0">
    <table>
      <thead><tr><th>Thời gian</th><th>Sự kiện</th><th>Machine ID</th><th>IP</th><th>Chi tiết</th></tr></thead>
      <tbody>
        <% events.forEach(function(e) { %>
        <tr>
          <td class="text-xs text-muted" style="white-space:nowrap"><%= e.ts %></td>
          <td>
            <% if (e.event === 'online') { %><span class="badge badge-success">Online</span>
            <% } else if (e.event === 'offline') { %><span class="badge badge-muted">Offline</span>
            <% } else if (e.event === 'deleted') { %><span class="badge badge-danger">Deleted</span>
            <% } else if (e.event === 'transfer') { %><span class="badge badge-info">Transfer</span>
            <% } else { %><span class="badge badge-muted"><%= e.event %></span><% } %>
          </td>
          <td><code title="<%= e.mid %>"><%= e.mid.slice(0, 8) %>…<%= e.mid.slice(-4) %></code></td>
          <td class="font-mono text-xs text-muted"><%= e.ip || '—' %></td>
          <td class="text-xs text-muted"><%= e.reason || '—' %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    </div>
    <% } %>
  </div>
</div>
</body>
</html>
