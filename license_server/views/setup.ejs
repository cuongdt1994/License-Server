<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Thiết lập lần đầu — License Manager</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
  <style>
    :root { --bg:#111827; --surface:#ffffff; --border:#e5e7eb; --text:#111827; --muted:#6b7280; --primary:#4f46e5; }
    * { box-sizing:border-box; }
    body { margin:0; min-height:100vh; font-family:'Segoe UI', system-ui, sans-serif; color:var(--text); background:linear-gradient(135deg,#eef2ff 0%,#f5f3ff 100%); display:flex; align-items:center; justify-content:center; padding:20px; }
    .setup-card { width:100%; max-width:720px; background:var(--surface); border:1px solid var(--border); border-radius:18px; box-shadow:0 20px 50px rgba(79,70,229,.12),0 4px 12px rgba(0,0,0,.04); padding:32px; }
    .brand { display:flex; gap:14px; align-items:center; margin-bottom:22px; }
    .brand-icon { width:54px; height:54px; border-radius:14px; background:linear-gradient(135deg,#6366f1,#8b5cf6); display:flex; align-items:center; justify-content:center; box-shadow:0 8px 20px rgba(99,102,241,.35); }
    .brand-icon i { color:#fff; font-size:1.6rem; }
    h1 { font-size:1.35rem; margin:0 0 4px; font-weight:800; }
    .sub { color:var(--muted); font-size:.9rem; margin:0; }
    .form-label { font-size:.8rem; font-weight:700; color:#374151; margin-bottom:6px; }
    .form-control { background:#f9fafb !important; color:var(--text) !important; border:1px solid var(--border) !important; border-radius:10px !important; padding:11px 14px !important; font-size:.92rem; }
    .form-control:focus { background:#fff !important; border-color:var(--primary) !important; box-shadow:0 0 0 3px rgba(79,70,229,.15) !important; }
    .hint { color:var(--muted); font-size:.78rem; margin-top:5px; }
    .grid { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
    .alert-soft { border-radius:10px; padding:12px 14px; font-size:.88rem; margin-bottom:18px; display:flex; gap:9px; align-items:flex-start; }
    .alert-error { background:#fef2f2; color:#b91c1c; border:1px solid #fecaca; }
    .alert-ok { background:#ecfdf5; color:#047857; border:1px solid #a7f3d0; }
    .btn-submit { background:linear-gradient(135deg,var(--primary),#7c3aed); color:#fff; border:none; border-radius:10px; padding:12px 16px; font-weight:700; display:inline-flex; align-items:center; justify-content:center; gap:8px; width:100%; }
    code { background:#eef2ff; color:#4338ca; padding:2px 6px; border-radius:5px; overflow-wrap:anywhere; }
    @media (max-width:640px) { .setup-card { padding:24px; } .grid { grid-template-columns:1fr; } }
  </style>
</head>
<body>
  <main class="setup-card">
    <div class="brand">
      <div class="brand-icon"><i class="bi bi-shield-lock-fill"></i></div>
      <div>
        <h1>Thiết lập lần đầu</h1>
        <p class="sub">Chọn nơi lưu dữ liệu và tạo tài khoản admin an toàn trước khi sử dụng License Manager.</p>
      </div>
    </div>

    <% if (error) { %>
      <div class="alert-soft alert-error"><i class="bi bi-exclamation-circle-fill"></i><span><%= error %></span></div>
    <% } %>

    <% if (result && result.ok) { %>
      <div class="alert-soft alert-ok">
        <i class="bi bi-check-circle-fill"></i>
        <span>
          Đã lưu cấu hình ban đầu vào <code><%= result.dataDir %></code>.
          <% if (result.restartRequired) { %>
            Vui lòng restart tiến trình để app đọc data dir mới, sau đó đăng nhập bằng tài khoản vừa tạo.
          <% } else { %>
            Bạn có thể đăng nhập ngay bằng tài khoản vừa tạo.
          <% } %>
        </span>
      </div>
      <a class="btn-submit text-decoration-none" href="/login"><i class="bi bi-box-arrow-in-right"></i>Đi tới đăng nhập</a>
    <% } else { %>
      <form method="POST" action="/setup" autocomplete="off">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="mb-3">
          <label class="form-label">Thư mục lưu data</label>
          <input name="data_dir" class="form-control" value="<%= suggestedDataDir %>" required>
          <div class="hint">Nên đặt ngoài thư mục <code>license_server</code> để rebuild/deploy không làm mất license.</div>
        </div>
        <div class="grid">
          <div class="mb-3">
            <label class="form-label">Tài khoản admin</label>
            <input name="username" class="form-control" value="admin" required>
          </div>
          <div></div>
          <div class="mb-3">
            <label class="form-label">Mật khẩu</label>
            <input name="password" type="password" class="form-control" minlength="10" required>
            <div class="hint">Tối thiểu 10 ký tự. Mật khẩu sẽ được lưu dạng hash.</div>
          </div>
          <div class="mb-3">
            <label class="form-label">Nhập lại mật khẩu</label>
            <input name="confirm_password" type="password" class="form-control" minlength="10" required>
          </div>
        </div>
        <button class="btn-submit" type="submit"><i class="bi bi-check2-circle"></i>Lưu thiết lập</button>
      </form>
    <% } %>
  </main>
</body>
</html>
