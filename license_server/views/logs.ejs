<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="refresh" content="15">
  <title>Logs — License Manager</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
</head>
<body>
<%- include('partials/topbar', { activePage: 'logs' }) %>
<div class="page page-md">

  <div class="page-head">
    <div>
      <div class="page-eyebrow">System logs</div>
      <h1 class="page-title">License Server Logs</h1>
      <p class="page-sub">80 dòng gần nhất · Auto refresh 15s</p>
    </div>
    <a href="/logs" class="btn btn-outline btn-sm">🔄 Refresh</a>
  </div>

  <div class="card" style="padding:16px">
    <% if (lines.length === 0) { %>
    <div class="empty" style="padding:40px"><i>📝</i><p>Chưa có log nào</p></div>
    <% } else { %>
    <pre style="background:#0f1723;border:1px solid var(--border);border-radius:var(--radius-sm);padding:16px;max-height:70vh;overflow:auto;white-space:pre-wrap;font-family:'Cascadia Code','Fira Code','JetBrains Mono','Consolas',monospace;font-size:.76rem;line-height:1.6;color:#cbd5e1;margin:0"><% lines.forEach(function(l) {
      var cls = '';
      if (/WARNING/i.test(l)) cls = 'color:#fbbf24';
      else if (/ERROR/i.test(l)) cls = 'color:#f87171';
      else if (/SECURITY/i.test(l)) cls = 'color:#f87171;font-weight:700';
      else if (/INFO.*OK/i.test(l)) cls = 'color:#34d399';
    %><div style="<%= cls %>"><%= l %></div><% }) %></pre>
    <% } %>
  </div>
</div>
</body>
</html>
