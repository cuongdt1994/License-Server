<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Verify 2FA — License Manager</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
  <style>
    :root { --bg:#0f1723; --surface:#1a2332; --border:#2a3441; --text:#e2e8f0; --muted:#94a3b8; --primary:#6366f1; --radius:10px; }
    * { box-sizing:border-box;margin:0;padding:0; }
    body { background:var(--bg);color:var(--text);font-family:'Segoe UI',system-ui,sans-serif;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px; }
    .card { background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:28px;width:100%;max-width:380px;text-align:center; }
    .card .icon { font-size:2rem;margin-bottom:14px; }
    .card h1 { font-size:1.2rem;font-weight:800;margin-bottom:6px; }
    .card p { color:var(--muted);font-size:.85rem;margin-bottom:18px; }
    .form-input { width:100%;background:#151e2d;color:var(--text);border:1px solid var(--border);border-radius:7px;padding:12px;font-size:1.1rem;outline:none;text-align:center;letter-spacing:.3em;font-family:'Cascadia Code',monospace;transition:border-color .2s; }
    .form-input:focus { border-color:var(--primary);box-shadow:0 0 0 3px rgba(99,102,241,.15); }
    .btn { display:flex;align-items:center;justify-content:center;gap:6px;padding:10px 20px;border-radius:7px;font-size:.85rem;font-weight:600;cursor:pointer;border:none;transition:all .15s;font-family:inherit;width:100%;margin-top:14px; }
    .btn-primary { background:var(--primary);color:#fff; }
    .btn-primary:hover { background:#4f46e5; }
    .alert { padding:12px 15px;border-radius:7px;margin-bottom:16px;font-size:.84rem;text-align:left; }
    .alert-danger { background:#450a0a;color:#fca5a5;border:1px solid #7f1d1d; }
  </style>
</head>
<body>
<div class="card">
  <div class="icon">🔐</div>
  <h1>Xác thực 2 bước</h1>
  <p>Nhập mã 6 chữ số từ Google Authenticator / Authy</p>

  <% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-danger">⚠️ <%= error %></div>
  <% } %>

  <form method="POST" action="/verify-2fa">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input name="token" class="form-input" placeholder="000000" maxlength="6" inputmode="numeric" pattern="[0-9]{6}" required autofocus autocomplete="one-time-code">
    <button type="submit" class="btn btn-primary">✅ Xác nhận</button>
  </form>
</div>
</body>
</html>
