<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Xác thực 2FA — License Manager</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
  <style>
    :root { --bg:#111827; --surface:#1f2937; --border:#374151; --text:#f9fafb; --muted:#9ca3af; --primary:#6366f1; }
    body { background: var(--bg); color: var(--text); font-family: 'Segoe UI', sans-serif;
           min-height: 100vh; display: flex; align-items: center; justify-content: center; margin: 0; }
    .card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px;
            padding: 36px; width: 400px; max-width: 95vw; }
    .card-title { font-size: 1.1rem; font-weight: 700; margin-bottom: 6px;
                  display: flex; align-items: center; gap: 8px; }
    .card-title i { color: var(--primary); font-size: 1.3rem; }
    .sub { font-size: .82rem; color: var(--muted); margin-bottom: 24px; }
    .form-group { margin-bottom: 16px; }
    .form-group label { display: block; font-size: .78rem; font-weight: 600; color: var(--muted);
                        text-transform: uppercase; letter-spacing: .05em; margin-bottom: 5px; }
    .otp-input { width: 100%; background: #161e2e; color: var(--text); border: 1px solid var(--border);
                 border-radius: 8px; padding: 14px; font-size: 1.5rem; text-align: center;
                 letter-spacing: .35em; outline: none; font-family: monospace; }
    .otp-input:focus { border-color: var(--primary); }
    .btn-primary { width: 100%; background: var(--primary); color: #fff; border: none;
                   padding: 12px; border-radius: 8px; font-size: .9rem; font-weight: 700; cursor: pointer; }
    .btn-primary:hover { opacity: .85; }
    .btn-back { display: block; text-align: center; margin-top: 14px; color: var(--muted);
                font-size: .82rem; text-decoration: none; }
    .btn-back:hover { color: var(--text); }
    .flash-danger { background: #7f1d1d; color: #fca5a5; border: 1px solid #991b1b;
                    padding: 10px 14px; border-radius: 8px; font-size: .875rem; margin-bottom: 16px;
                    display: flex; align-items: center; gap: 8px; }
    .info-line { background: #161e2e; border-left: 3px solid var(--primary); padding: 10px 14px;
                 border-radius: 6px; font-size: .82rem; color: var(--muted); margin-bottom: 18px; }
  </style>
</head>
<body>
<div class="card">
  <div class="card-title"><i class="bi bi-shield-lock"></i>Xác thực hai bước</div>
  <p class="sub">Nhập mã 6 chữ số từ Google Authenticator hoặc Authy.</p>

  <% if (error) { %>
  <div class="flash-danger"><i class="bi bi-exclamation-circle"></i><%= error %></div>
  <% } %>

  <div class="info-line">
    <i class="bi bi-info-circle me-1"></i>
    Mã thay đổi mỗi 30 giây. Nếu mã không đúng, đợi mã mới rồi thử lại.
  </div>

  <form method="POST" action="/verify-2fa">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-group">
      <label>Mã xác thực OTP</label>
      <input type="text" name="token" class="otp-input" maxlength="6" inputmode="numeric"
             pattern="[0-9]{6}" placeholder="000000" autocomplete="one-time-code" autofocus required>
    </div>
    <button type="submit" class="btn-primary"><i class="bi bi-check2-circle me-2"></i>Xác thực</button>
  </form>
  <a href="/logout" class="btn-back"><i class="bi bi-arrow-left me-1"></i>Hủy & Quay lại đăng nhập</a>
</div>

<script>
  // Auto-submit khi nhập đủ 6 số
  const inp = document.querySelector('.otp-input');
  inp.addEventListener('input', () => {
    inp.value = inp.value.replace(/\D/g, '');
    if (inp.value.length === 6) inp.form.submit();
  });
</script>
</body>
</html>
