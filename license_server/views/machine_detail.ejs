<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Machine Detail — License Manager</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
</head>
<body>
<%- include('partials/topbar', { activePage: 'machines' }) %>
<div class="page">

  <% if (typeof flash !== 'undefined' && flash) { %>
  <div class="alert alert-<%= flash.type %>">
    <% if (flash.type === 'success') { %>✅<% } else { %>⚠️<% } %>
    <span style="white-space:pre-line"><%= flash.msg %></span>
    <button class="alert-close" onclick="this.parentElement.remove()">×</button>
  </div>
  <% } %>

  <%
    var td = TIERS[entry.tier] || TIERS.basic;
  %>

  <div class="page-head">
    <div>
      <div class="page-eyebrow">Machine detail</div>
      <h1 class="page-title"><code><%= mid %></code></h1>
      <p class="page-sub">
        <span class="tier-badge" style="background:<%= td.bg %>;color:<%= td.color %>"><%= td.label %></span>
        <% if (isOnline) { %><span class="badge badge-success" style="margin-left:6px">🟢 Online</span>
        <% } else { %><span class="badge badge-muted" style="margin-left:6px">Offline</span><% } %>
        <% if (expired) { %><span class="badge badge-danger" style="margin-left:6px">Expired</span><% } %>
        <% if (entry.revoked) { %><span class="badge badge-danger" style="margin-left:6px">Revoked</span><% } %>
      </p>
    </div>
    <div class="flex gap-2">
      <a href="/machines" class="btn btn-outline btn-sm">← Machines</a>
      <a href="/history?mid=<%= encodeURIComponent(mid) %>" class="btn btn-outline btn-sm">📜 History</a>
    </div>
  </div>

  <!-- Machine info -->
  <div class="stat-grid" style="grid-template-columns:repeat(auto-fit,minmax(180px,1fr))">
    <div class="stat-card" style="--accent:#6366f1">
      <div class="stat-label">Max Players</div>
      <div class="stat-value" style="font-size:1.5rem"><%= max_players %></div>
    </div>
    <div class="stat-card" style="--accent:#22c55e">
      <div class="stat-label">Online Players</div>
      <div class="stat-value" style="font-size:1.5rem"><%= live ? live.players : 0 %></div>
    </div>
    <div class="stat-card" style="--accent:#f59e0b">
      <div class="stat-label">Peak Players</div>
      <div class="stat-value" style="font-size:1.5rem"><%= entry.peak_players || 0 %></div>
    </div>
    <div class="stat-card" style="--accent:#8b5cf6">
      <div class="stat-label">Expiry</div>
      <div class="stat-value text-sm" style="font-size:.9rem">
        <% if (expiry) { %><%= expiry.daysLeft %>d — <%= expiry.date %>
        <% } else { %>Không hết hạn<% } %>
      </div>
    </div>
  </div>

  <!-- Key info -->
  <div class="card">
    <div class="card-title">🔑 License Info</div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
      <div class="form-group">
        <label class="form-label">License Key</label>
        <div class="font-mono text-sm" style="background:var(--panel);border:1px solid var(--border);border-radius:var(--radius-sm);padding:10px 13px;word-break:break-all">
          <%= entry.license_key || '— chưa cấp —' %>
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Ghi chú</label>
        <div style="background:var(--panel);border:1px solid var(--border);border-radius:var(--radius-sm);padding:10px 13px;font-size:.85rem">
          <%= entry.note || '—' %>
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Ngày cấp</label>
        <div class="text-sm"><%= entry.added || '—' %></div>
      </div>
      <div class="form-group">
        <label class="form-label">IP</label>
        <div class="font-mono text-sm"><%= live ? live.ip : '—' %></div>
      </div>
    </div>
    <% if (Array.isArray(entry.allowed_ips) && entry.allowed_ips.length) { %>
    <div class="form-group mt-3">
      <label class="form-label">IP Whitelist</label>
      <div class="text-sm font-mono"><%= entry.allowed_ips.join(', ') %></div>
    </div>
    <% } %>
  </div>

  <!-- Agent section -->
  <div class="card">
    <div class="card-title">🤖 Agent Status</div>
    <% if (agentInfo) { %>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px;margin-bottom:16px">
        <div class="stat-card" style="--accent:<%= agentInfo.online ? '#22c55e' : '#ef4444' %>">
          <div class="stat-label">Agent</div>
          <div class="stat-value text-sm" style="font-size:.9rem">
            <% if (agentInfo.online) { %><span class="badge badge-success">Online</span>
            <% } else { %><span class="badge badge-muted">Offline</span><% } %>
          </div>
          <div class="stat-sub">Last seen: <%= agentInfo.last_seen ? new Date(agentInfo.last_seen).toLocaleString('vi-VN') : '—' %></div>
        </div>
        <div class="stat-card" style="--accent:#6366f1">
          <div class="stat-label">Agent IP</div>
          <div class="stat-value text-sm" style="font-size:.85rem;font-family:monospace"><%= agentInfo.agent_ip || '—' %></div>
        </div>
        <div class="stat-card" style="--accent:#f59e0b">
          <div class="stat-label">Server Dir</div>
          <div class="stat-value text-sm" style="font-size:.85rem"><code><%= (typeof safeActions !== 'undefined' && agentInfo.server_dir) || 'pwserver' %></code></div>
        </div>
      </div>

      <div class="flex gap-2 flex-wrap mb-3">
        <form method="POST" action="/machine/<%= encodeURIComponent(mid) %>/agent-install" style="display:inline">
          <div class="flex gap-2 items-end">
            <div class="form-group" style="margin:0">
              <label class="form-label">Server Dir</label>
              <input name="server_dir" class="form-input" value="<%= (agentInfo && agentInfo.server_dir) || 'pwserver' %>" style="width:140px">
            </div>
            <button type="submit" class="btn btn-primary btn-sm">📥 Get Install Command</button>
          </div>
        </form>
        <form method="POST" action="/machine/<%= encodeURIComponent(mid) %>/agent-rotate" style="display:inline" onsubmit="return confirm('Cấp token mới — cần chạy lại lệnh cài đặt?')">
          <button type="submit" class="btn btn-outline btn-sm">🔄 Rotate Token</button>
        </form>
        <form method="POST" action="/machine/<%= encodeURIComponent(mid) %>/agent-uninstall" style="display:inline" onsubmit="return confirm('Gỡ agent khỏi license server?')">
          <button type="submit" class="btn btn-danger btn-sm">🗑 Uninstall</button>
        </form>
      </div>

      <!-- Server Control -->
      <% if (agentInfo && agentInfo.online) { %>
      <div class="divider"><span>Server Control</span></div>
      <div class="flex gap-2 flex-wrap mb-3">
        <form method="POST" action="/machine/<%= encodeURIComponent(mid) %>/start" style="display:inline"><button type="submit" class="btn btn-success btn-sm">▶ Start</button></form>
        <form method="POST" action="/machine/<%= encodeURIComponent(mid) %>/stop" style="display:inline" onsubmit="return confirm('Stop server?')"><button type="submit" class="btn btn-danger btn-sm">⏹ Stop</button></form>
        <form method="POST" action="/machine/<%= encodeURIComponent(mid) %>/restart" style="display:inline" onsubmit="return confirm('Restart server?')"><button type="submit" class="btn btn-warning btn-sm">🔄 Restart</button></form>
      </div>

      <!-- Safe Actions -->
      <% if (typeof safeActions !== 'undefined' && safeActions && safeActions.length) { %>
      <div class="flex gap-2 flex-wrap">
        <% safeActions.forEach(function(sa) { %>
        <button type="button" class="btn btn-outline btn-sm" onclick="runSafeAction('<%= sa.id %>')" title="<%= sa.desc || '' %>"><%= sa.label %></button>
        <% }) %>
      </div>
      <% } %>
      <% } %>
    <% } else { %>
    <div class="alert alert-info">🤖 Chưa cài đặt agent cho machine này. Nhấn "Get Install Command" để lấy lệnh cài đặt.</div>
    <% } %>
  </div>
</div>

<script>
function runSafeAction(action) {
  if (!confirm('Chạy action: ' + action + '?')) return;
  fetch('/api/machine/<%= encodeURIComponent(mid) %>/safe-action', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'x-csrf-token': window._csrfToken || '' },
    body: JSON.stringify({ action: action })
  })
  .then(r => r.json())
  .then(d => { if (d.error) alert('Lỗi: ' + d.error); else alert('Đã gửi: ' + d.label + ' (id=' + d.id + ')'); })
  .catch(e => alert('Lỗi: ' + e.message));
}
</script>
</body>
</html>
