<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="refresh" content="30">
  <title>Dashboard — License Manager</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
</head>
<body>

<%- include('partials/topbar', { activePage: 'dashboard' }) %>

<div class="page">

  <% if (typeof flash !== 'undefined' && flash) { %>
  <div class="alert alert-<%= flash.type %>">
    <% if (flash.type === 'success') { %>✅<% } else { %>⚠️<% } %>
    <span><%= flash.msg %></span>
    <button class="alert-close" onclick="this.parentElement.remove()">×</button>
  </div>
  <% } %>

  <div class="page-head">
    <div>
      <div class="page-eyebrow">Live operations</div>
      <h1 class="page-title">License Dashboard</h1>
      <p class="page-sub">Theo dõi license, player count và các server đang kết nối.</p>
    </div>
    <div class="flex gap-2">
      <a href="/health" target="_blank" class="btn btn-outline btn-sm">❤️ Health</a>
      <a href="/logs" class="btn btn-outline btn-sm">📝 Logs</a>
      <a href="/settings" class="btn btn-outline btn-sm">🔧 Settings</a>
    </div>
  </div>

  <% if (maintenance) { %>
  <div class="alert alert-warning">
    🔧 <span><b>Maintenance mode đang BẬT</b> — Tất cả AUTH/HB từ game server bị từ chối. Vào <a href="/settings" style="color:#fbbf24;font-weight:700">Settings</a> để tắt.</span>
  </div>
  <% } %>

  <!-- Stat cards -->
  <div class="stat-grid">
    <div class="stat-card" style="--accent:#22c55e">
      <div class="stat-label">🟢 Đang online</div>
      <div class="stat-value"><%= active_count %></div>
    </div>
    <div class="stat-card" style="--accent:#6366f1">
      <div class="stat-label">📦 Tổng license</div>
      <div class="stat-value"><%= total %></div>
    </div>
    <div class="stat-card" style="--accent:#ef4444">
      <div class="stat-label">🚫 Đã revoke</div>
      <div class="stat-value"><%= revoked %></div>
    </div>
    <div class="stat-card" style="--accent:#f59e0b">
      <div class="stat-label">⏰ Đã hết hạn</div>
      <div class="stat-value"><%= expired %></div>
    </div>
    <div class="stat-card" style="--accent:#8b5cf6">
      <div class="stat-label">👥 Players online</div>
      <div class="stat-value"><%= total_players %></div>
    </div>
  </div>

  <!-- Runtime status -->
  <div class="stat-grid">
    <div class="stat-card" style="--accent:#22c55e">
      <div class="stat-label">🔒 Transport</div>
      <div class="stat-value" style="font-size:20px"><%= transport && transport.listening ? 'TLS-only' : 'TLS down' %></div>
      <div class="card-sub">Port <%= transport ? transport.port : '—' %> · <%= transport ? transport.min_version : '—' %></div>
    </div>
    <div class="stat-card" style="--accent:#0ea5e9">
      <div class="stat-label">🗄️ Database</div>
      <div class="stat-value" style="font-size:20px"><%= database && database.ok ? 'SQLite WAL' : 'SQLite lỗi' %></div>
      <div class="card-sub"><%= database ? Math.round((database.db_size_bytes || 0) / 1024 / 1024 * 100) / 100 : 0 %> MB</div>
    </div>
    <div class="stat-card" style="--accent:#a78bfa">
      <div class="stat-label">🤝 TLS connections</div>
      <div class="stat-value"><%= transport ? transport.connections : 0 %></div>
    </div>
    <div class="stat-card" style="--accent:#f59e0b">
      <div class="stat-label">🎟️ AUTH2 sessions</div>
      <div class="stat-value"><%= typeof auth2_sessions !== 'undefined' ? auth2_sessions : 0 %></div>
    </div>
  </div>

  <div class="card" style="padding:14px 18px">
    <div class="card-sub">
      Chứng chỉ hết hạn: <b><%= transport && transport.certificate_valid_to ? new Date(transport.certificate_valid_to).toLocaleString('vi-VN') : '—' %></b>
      · WAL: <b><%= database ? Math.round((database.wal_size_bytes || 0) / 1024) : 0 %> KB</b>
      · Transport: <b style="color:#22c55e">TLS</b>
    </div>
  </div>

  <!-- Player chart -->
  <div class="card">
    <div class="card-header">
      <div class="card-title">📈 Player count — 12 giờ qua</div>
      <div id="chartStatus" class="card-sub">Đang tải...</div>
    </div>
    <div style="position:relative;height:200px">
      <canvas id="playerChart"></canvas>
    </div>
  </div>

  <!-- Active servers table -->
  <div class="card" style="padding:0;overflow:hidden">
    <div class="card-header" style="padding:16px 20px">
      <div class="card-title">🟢 Servers đang hoạt động</div>
      <div class="card-sub">
        Auto refresh 30s · <span style="color:#fbbf24"><%= typeof last_updated !== 'undefined' ? last_updated : '—' %></span>
      </div>
    </div>

    <% if (rows.length === 0) { %>
    <div class="empty">
      <i>🖥️</i>
      <p>Chưa có server nào kết nối</p>
    </div>
    <% } else { %>
    <div class="table-wrap" style="border:none;border-radius:0">
    <table>
      <thead>
        <tr>
          <th>Machine ID</th>
          <th>IP</th>
          <th>Players / Limit</th>
          <th>Tier</th>
          <th>Last seen</th>
          <th>Online từ</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(function(r) {
          var td = TIERS[r.tier] || TIERS.basic;
        %>
        <tr>
          <td>
            <code><%= r.mid %></code>
            <% if (r.pending_cfg) { %>
              <span class="badge badge-warning" style="font-size:.7rem;margin-left:4px" title="Cấu hình đang chờ đồng bộ (≤5s)">⏳ sync</span>
            <% } %>
          </td>
          <td class="font-mono text-sm"><%= r.ip %></td>
          <td style="min-width:170px">
            <div class="flex items-center gap-2">
              <span style="font-weight:700;font-size:.9rem;<%= r.pct>80?'color:#ef4444':r.pct>50?'color:#f59e0b':'color:#22c55e' %>">
                <%= r.players %> / <%= r.max_players %>
              </span>
              <span class="text-xs text-muted"><%= r.pct %>%</span>
            </div>
            <div class="progress-bar">
              <div class="progress-fill" style="width:<%= Math.min(r.pct,100) %>%;background:<%= r.pct>80?'#ef4444':r.pct>50?'#f59e0b':'#22c55e' %>"></div>
            </div>
          </td>
          <td>
            <span class="tier-badge" style="background:<%= td.bg %>;color:<%= td.color %>"><%= td.label %></span>
          </td>
          <td class="text-sm text-muted"><%= r.last_seen %></td>
          <td class="text-sm text-muted"><%= r.uptime_start %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    </div>
    <% } %>
  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
Chart.defaults.color = '#94a3b8';
Chart.defaults.borderColor = '#2a3441';

const ctx = document.getElementById('playerChart').getContext('2d');
const chart = new Chart(ctx, {
  type: 'line',
  data: {
    labels: [],
    datasets: [{
      label: 'Tổng players',
      data: [],
      borderColor: '#6366f1',
      backgroundColor: 'rgba(99,102,241,.12)',
      borderWidth: 2,
      pointRadius: 2,
      pointHoverRadius: 5,
      fill: true,
      tension: 0.35,
    }]
  },
  options: {
    responsive: true,
    maintainAspectRatio: false,
    animation: { duration: 400 },
    plugins: { legend: { display: false } },
    scales: {
      x: { grid: { color: '#1f2937' }, ticks: { maxTicksLimit: 8, maxRotation: 0, font: { size: 11 } } },
      y: { grid: { color: '#1f2937' }, beginAtZero: true, ticks: { precision: 0, font: { size: 11 } } }
    }
  }
});

function fmtTime(ms) {
  const d = new Date(ms);
  return d.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
}

function loadChart() {
  fetch('/api/stats')
    .then(r => r.json())
    .then(data => {
      const pts = data.total || [];
      chart.data.labels = pts.map(p => fmtTime(p[0]));
      chart.data.datasets[0].data = pts.map(p => p[1]);
      chart.update();
      const el = document.getElementById('chartStatus');
      if (pts.length === 0) el.textContent = 'Chưa có dữ liệu';
      else {
        const last = pts[pts.length - 1];
        el.textContent = pts.length + ' điểm · cập nhật ' + fmtTime(last[0]);
      }
    })
    .catch(() => { document.getElementById('chartStatus').textContent = 'Không tải được dữ liệu'; });
}

loadChart();
setInterval(loadChart, 80 * 1000);
</script>
</body>
</html>
