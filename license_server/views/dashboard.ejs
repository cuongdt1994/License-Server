<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dashboard — License Manager</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
  <style>
    :root {
      --bg:       #111827;
      --surface:  #1f2937;
      --border:   #374151;
      --text:     #f9fafb;
      --muted:    #9ca3af;
      --primary:  #6366f1;
    }
    * { box-sizing: border-box; }
    body        { background: radial-gradient(circle at top left, #172033 0, var(--bg) 34%); color: var(--text); font-family: 'Segoe UI', sans-serif; margin: 0; min-height: 100vh; }
    .topbar     { background: var(--surface); border-bottom: 1px solid var(--border);
                  padding: 12px 24px; display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap; position: sticky; top: 0; z-index: 20; }
    .topbar-brand { font-weight: 700; font-size: 1.1rem; display: flex; align-items: center; gap: 8px; }
    .topbar-brand i { color: var(--primary); font-size: 1.3rem; }
    .nav-btns { overflow-x: auto; max-width: 100%; padding-bottom: 2px; }
    .nav-btns a { color: #d1d5db; text-decoration: none; padding: 6px 14px;
                  border-radius: 6px; font-size: .875rem; transition: background .15s; }
    .nav-btns a:hover        { background: var(--border); color: #fff; }
    .nav-btns a.active       { background: var(--primary); color: #fff; }
    .nav-btns a.btn-logout   { color: #f87171; border: 1px solid #f87171; }
    .nav-btns a.btn-logout:hover { background: #f87171; color: #fff; }
    .page       { padding: 24px; max-width: 1480px; margin: 0 auto; }
    .page-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 18px; margin-bottom: 18px; }
    .eyebrow { color: #93c5fd; font-size: .76rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; margin-bottom: 6px; }
    .page-title { margin: 0; font-size: 1.35rem; line-height: 1.2; font-weight: 800; }
    .page-sub { margin-top: 6px; color: var(--muted); font-size: .875rem; }
    .quick-actions { display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
    .quick-actions a { border: 1px solid var(--border); color: #d1d5db; text-decoration: none; padding: 7px 12px; border-radius: 8px; font-size: .82rem; display: inline-flex; align-items: center; gap: 6px; background: rgba(22,30,46,.7); }
    .quick-actions a:hover { background: var(--border); color: #fff; }
    /* ── Stat cards (5 columns) ── */
    .stat-grid  { display: grid; grid-template-columns: repeat(5, 1fr); gap: 14px; margin-bottom: 20px; }
    @media (max-width: 1100px) { .stat-grid { grid-template-columns: repeat(3, 1fr); } }
    @media (max-width: 640px)  { .stat-grid { grid-template-columns: repeat(2, 1fr); } }
    .stat-card  { background: rgba(31,41,55,.92); border: 1px solid var(--border);
                  border-radius: 8px; padding: 16px 18px; position: relative; overflow: hidden; box-shadow: 0 14px 35px rgba(0,0,0,.16); }
    .stat-card::before { content: ''; position: absolute; top: 0; left: 0;
                         width: 4px; height: 100%; background: var(--accent); border-radius: 2px 0 0 2px; }
    .stat-card .label { font-size: .78rem; font-weight: 600; color: var(--muted);
                        text-transform: uppercase; letter-spacing: .05em; margin-bottom: 8px; }
    .stat-card .value { font-size: 1.9rem; font-weight: 800; line-height: 1; }
    /* ── Chart card ── */
    .chart-card { background: rgba(31,41,55,.92); border: 1px solid var(--border); border-radius: 8px;
                  padding: 20px; margin-bottom: 20px; }
    .chart-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
    .chart-head .title { font-weight: 600; font-size: .95rem; display: flex; align-items: center; gap: 8px; }
    .chart-head .title i { color: var(--primary); }
    .chart-head .sub    { font-size: .78rem; color: var(--muted); }
    .chart-wrap { position: relative; height: 200px; }
    /* ── Table card ── */
    .tcard      { background: rgba(31,41,55,.92); border: 1px solid var(--border); border-radius: 8px; overflow: hidden; }
    .tcard-head { padding: 16px 20px; border-bottom: 1px solid var(--border);
                  display: flex; justify-content: space-between; align-items: center; }
    .tcard-head .title { font-weight: 600; font-size: .95rem; display: flex; align-items: center; gap: 8px; }
    .tcard-head .title i { color: #34d399; }
    .tcard-head .refresh-info { font-size: .8rem; color: var(--muted); }
    .tcard-head .refresh-info span { color: #fbbf24; font-weight: 600; }
    .table-scroll { width: 100%; overflow-x: auto; }
    table       { width: 100%; min-width: 920px; border-collapse: collapse; }
    thead th    { background: #161e2e; color: #9ca3af; font-size: .78rem; font-weight: 600;
                  text-transform: uppercase; letter-spacing: .05em; padding: 12px 16px; text-align: left; }
    tbody tr    { border-bottom: 1px solid var(--border); transition: background .1s; }
    tbody tr:last-child { border-bottom: none; }
    tbody tr:hover { background: #273044; }
    tbody td    { padding: 14px 16px; font-size: .875rem; vertical-align: middle; }
    .empty-state { padding: 60px 20px; text-align: center; color: var(--muted); }
    .empty-state i { font-size: 2.5rem; display: block; margin-bottom: 12px; color: var(--border); }
    /* ── Badges ── */
    .pill       { display: inline-block; padding: 3px 10px; border-radius: 999px;
                  font-size: .78rem; font-weight: 600; }
    .pill-green { background: #064e3b; color: #34d399; }
    .pill-red   { background: #7f1d1d; color: #f87171; }
    .pill-gray  { background: #374151; color: #9ca3af; }
    .tier-badge { display: inline-block; padding: 2px 8px; border-radius: 999px;
                  font-size: .72rem; font-weight: 700; margin-left: 6px; }
    /* ── Flash ── */
    .flash      { padding: 12px 16px; border-radius: 8px; margin-bottom: 20px;
                  font-size: .875rem; display: flex; align-items: center; gap: 10px; }
    .flash-success { background: #064e3b; color: #6ee7b7; border: 1px solid #065f46; }
    .flash-danger  { background: #7f1d1d; color: #fca5a5; border: 1px solid #991b1b; }
    code { background: #161e2e; color: #a5b4fc; padding: 2px 6px; border-radius: 4px; font-size: .8rem; }
    @media (max-width: 820px) {
      .page-head { display: block; }
      .page { padding: 18px; }
    }
  </style>
</head>
<body>

<!-- Navbar -->
<div class="topbar">
  <div class="topbar-brand">
    <i class="bi bi-shield-lock-fill"></i>
    License Manager
  </div>
  <div class="nav-btns d-flex gap-1">
    <a href="/"         class="active">Dashboard</a>
    <a href="/machines">Machines</a>
    <a href="/plans">Plans</a>
    <a href="/operations">Operations</a>
    <a href="/bans">IP Bans</a>
    <a href="/history">History</a>
    <a href="/logs">Logs</a>
    <a href="/settings">Settings</a>
    <a href="/logout"   class="btn-logout">Logout</a>
  </div>
</div>

<div class="page">

  <%- include('partials/flash-toast', { flash: flash }) %>

  <div class="page-head">
    <div>
      <div class="eyebrow">Live operations</div>
      <h1 class="page-title">License Dashboard</h1>
      <div class="page-sub">Theo dõi license, player count, maintenance và các server đang kết nối.</div>
    </div>
    <div class="quick-actions">
      <a href="/health" target="_blank"><i class="bi bi-heart-pulse"></i>Health</a>
      <a href="/logs"><i class="bi bi-terminal"></i>Logs</a>
      <a href="/settings"><i class="bi bi-sliders"></i>Runtime</a>
    </div>
  </div>

  <!-- ── Maintenance banner ── -->
  <% if (maintenance) { %>
  <div class="flash" style="background:#451a03;color:#fbbf24;border:1px solid #78350f">
    <i class="bi bi-tools"></i>
    <div style="flex:1">
      <b>Maintenance mode đang BẬT</b> — Tất cả AUTH/HB từ game server bị từ chối.
    </div>
    <form method="POST" action="/maintenance" style="display:inline">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="action" value="off">
      <button type="submit" style="background:#78350f;color:#fbbf24;border:1px solid #92400e;padding:5px 14px;border-radius:6px;font-size:.8rem;font-weight:700;cursor:pointer">
        Tắt maintenance
      </button>
    </form>
  </div>
  <% } else { %>
  <div style="background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:12px 18px;margin-bottom:20px;display:flex;align-items:center;gap:12px;flex-wrap:wrap">
    <i class="bi bi-tools" style="color:#fbbf24;font-size:1.1rem"></i>
    <div style="flex:1;font-size:.85rem;color:var(--muted)">
      <b style="color:var(--text)">Maintenance mode</b> — Bật để từ chối mọi AUTH/HB tạm thời (deploy, sửa lỗi).
    </div>
    <form method="POST" action="/maintenance" style="display:flex;gap:6px;align-items:center">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="action" value="on">
      <input type="number" name="minutes" placeholder="Phút (0=∞)" min="0" max="1440" value="30"
             style="width:90px;background:#161e2e;color:var(--text);border:1px solid var(--border);border-radius:6px;padding:5px 8px;font-size:.8rem">
      <button type="submit" style="background:#78350f;color:#fbbf24;border:1px solid #92400e;padding:5px 14px;border-radius:6px;font-size:.8rem;font-weight:700;cursor:pointer">
        Bật maintenance
      </button>
    </form>
  </div>
  <% } %>

  <!-- ── Stat cards ── -->
  <div class="stat-grid">
    <div class="stat-card" style="--accent:#34d399">
      <div class="label">Đang online</div>
      <div class="value" style="color:#34d399"><%= active_count %></div>
    </div>
    <div class="stat-card" style="--accent:#818cf8">
      <div class="label">Tổng cấp phép</div>
      <div class="value"><%= total %></div>
    </div>
    <div class="stat-card" style="--accent:#f87171">
      <div class="label">Đã revoke</div>
      <div class="value" style="color:#f87171"><%= revoked %></div>
    </div>
    <div class="stat-card" style="--accent:#fbbf24">
      <div class="label">Đã hết hạn</div>
      <div class="value" style="color:#fbbf24"><%= expired %></div>
    </div>
    <div class="stat-card" style="--accent:#a78bfa">
      <div class="label">Players online</div>
      <div class="value" style="color:#a78bfa"><%= total_players %></div>
    </div>
  </div>

  <!-- ── Player count chart ── -->
  <div class="chart-card">
    <div class="chart-head">
      <div class="title">
        <i class="bi bi-graph-up"></i>
        Player count — 12 giờ qua
      </div>
      <div class="sub" id="chartStatus">Đang tải...</div>
    </div>
    <div class="chart-wrap">
      <canvas id="playerChart"></canvas>
    </div>
  </div>

  <!-- ── Active servers table ── -->
  <div class="tcard">
    <div class="tcard-head">
      <div class="title">
        <i class="bi bi-activity"></i>
        Servers đang hoạt động
      </div>
      <div class="refresh-info">
        Live update — <span id="cd" style="color:#34d399">connecting...</span>
      </div>
    </div>

    <% if (rows.length === 0) { %>
    <div class="empty-state">
      <i class="bi bi-hdd-x"></i>
      Chưa có server nào kết nối
    </div>
    <% } else { %>
    <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>Machine ID</th>
          <th>IP</th>
          <th>Players / Giới hạn</th>
          <th>Tier</th>
          <th>Last seen</th>
          <th>Online từ</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(function(r) {
             var td = TIERS[r.tier] || TIERS.basic;
        %>
        <tr>
          <td><code><%= r.mid %></code></td>
          <td style="font-family:monospace;font-size:.82rem"><%= r.ip %></td>
          <td style="min-width:160px">
            <div style="display:flex;align-items:center;gap:8px">
              <span style="font-weight:700;font-size:.9rem;<%= r.pct>80?'color:#f87171':r.pct>50?'color:#fbbf24':'color:#34d399' %>">
                <%= r.players %> / <%= r.max_players %>
              </span>
              <span style="font-size:.75rem;color:var(--muted)"><%= r.pct %>%</span>
            </div>
            <div style="margin-top:5px;height:5px;border-radius:3px;background:#374151;overflow:hidden">
              <div style="height:100%;width:<%= Math.min(r.pct,100) %>%;border-radius:3px;
                          background:<%= r.pct>80?'#f87171':r.pct>50?'#fbbf24':'#34d399' %>;transition:width .3s"></div>
            </div>
          </td>
          <td>
            <span class="tier-badge" style="background:<%= td.bg %>;color:<%= td.color %>">
              <%= td.label %>
            </span>
          </td>
          <td style="color:var(--muted);font-size:.82rem;white-space:nowrap"><%= r.last_seen %></td>
          <td style="color:var(--muted);font-size:.82rem;white-space:nowrap"><%= r.uptime_start %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    </div>
    <% } %>
  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
  // ═══════════════════════════════════════════════════════════════════════════
  // WebSocket live updates — không reload trang, mượt hơn
  // ═══════════════════════════════════════════════════════════════════════════
  const proto = location.protocol === 'https:' ? 'wss:' : 'ws:';
  const wsUrl = proto + '//' + location.host + '/ws';
  let ws = null;
  let wsReconnectTimer = null;

  function connectWS() {
    if (ws && ws.readyState === WebSocket.OPEN) return;
    try {
      ws = new WebSocket(wsUrl);
    } catch (e) {
      scheduleReconnect();
      return;
    }

    ws.onopen = () => {
      document.getElementById('cd').textContent = 'live';
      document.getElementById('cd').style.color = '#34d399';
    };

    ws.onmessage = (event) => {
      try {
        const msg = JSON.parse(event.data);
        if (msg.event === 'init') {
          // Full snapshot on connect — cập nhật toàn bộ bảng
          rebuildServerTable(msg.data || []);
        } else if (msg.event === 'machine.online') {
          handleServerOnline(msg.data || msg);
        } else if (msg.event === 'machine.offline') {
          handleServerOffline(msg.data || msg);
        } else if (msg.event === 'machine.hb') {
          handleServerHB(msg.data || msg);
        }
      } catch (e) { /* ignore malformed */ }
    };

    ws.onclose = () => {
      document.getElementById('cd').textContent = 'reconnect...';
      document.getElementById('cd').style.color = '#fbbf24';
      scheduleReconnect();
    };

    ws.onerror = () => {
      ws?.close();
    };
  }

  function scheduleReconnect() {
    if (wsReconnectTimer) return;
    wsReconnectTimer = setTimeout(() => {
      wsReconnectTimer = null;
      connectWS();
    }, 3000);
  }

  // ── Server table management ──────────────────────────────────────────────
  const tbody = document.querySelector('tbody');
  const emptyState = document.querySelector('.empty-state');
  const tableScroll = document.querySelector('.table-scroll');
  let serverRows = {}; // mid → tr element

  function getTierBadge(tier) {
    const TIERS = {
      trial:     { label: 'Trial',     bg: '#451a03', color: '#fbbf24' },
      basic:     { label: 'Basic',     bg: '#1e3a5f', color: '#60a5fa' },
      pro:       { label: 'Pro',       bg: '#2e1065', color: '#a78bfa' },
      unlimited: { label: 'Unlimited', bg: '#064e3b', color: '#34d399' },
    };
    const td = TIERS[tier] || TIERS.basic;
    return '<span style="display:inline-block;padding:2px 8px;border-radius:999px;font-size:.72rem;font-weight:700;background:' + td.bg + ';color:' + td.color + '">' + td.label + '</span>';
  }

  function createServerRow(srv) {
    const tr = document.createElement('tr');
    const maxPl = srv.max_players || 0;
    const players = srv.players || 0;
    const pct = maxPl ? Math.round(players / maxPl * 100) : 0;
    const barColor = pct > 80 ? '#f87171' : pct > 50 ? '#fbbf24' : '#34d399';

    tr.id = 'srv-' + srv.mid.replace(/[^a-zA-Z0-9]/g, '_');
    tr.innerHTML =
      '<td><code>' + srv.mid + '</code></td>' +
      '<td style="font-family:monospace;font-size:.82rem">' + (srv.ip || '?') + '</td>' +
      '<td style="min-width:160px">' +
        '<div style="display:flex;align-items:center;gap:8px">' +
          '<span class="srv-players" style="font-weight:700;font-size:.9rem;color:' + barColor + '">' + players + ' / ' + maxPl + '</span>' +
          '<span class="srv-pct" style="font-size:.75rem;color:var(--muted)">' + pct + '%</span>' +
        '</div>' +
        '<div style="margin-top:5px;height:5px;border-radius:3px;background:#374151;overflow:hidden">' +
          '<div class="srv-bar" style="height:100%;width:' + Math.min(pct, 100) + '%;border-radius:3px;background:' + barColor + ';transition:width .3s"></div>' +
        '</div>' +
      '</td>' +
      '<td>' + getTierBadge(srv.tier || 'basic') + '</td>' +
      '<td class="srv-seen" style="color:var(--muted);font-size:.82rem;white-space:nowrap">' + (srv.last_seen || '—') + '</td>' +
      '<td class="srv-uptime" style="color:var(--muted);font-size:.82rem;white-space:nowrap">' + (srv.uptime_start || '—') + '</td>';
    return tr;
  }

  function updateStatCards(data) {
    // Cập nhật stat cards từ dữ liệu snapshot
    const onlineCount = data.length;
    const totalPlayers = data.reduce((s, r) => s + (r.players || 0), 0);
    const values = document.querySelectorAll('.stat-card .value');
    if (values.length >= 5) {
      values[0].textContent = onlineCount;
      values[4].textContent = totalPlayers;
    }
  }

  function rebuildServerTable(data) {
    const oldRows = {};
    Object.entries(serverRows).forEach(([mid, tr]) => { oldRows[mid] = tr; });
    serverRows = {};

    if (!data.length) {
      if (emptyState) emptyState.style.display = '';
      if (tableScroll) tableScroll.style.display = 'none';
      // Remove all existing rows
      if (tbody) tbody.innerHTML = '';
      document.querySelector('.refresh-info span').textContent = '0';
      updateStatCards([]);
      return;
    }

    if (emptyState) emptyState.style.display = 'none';
    if (tableScroll) tableScroll.style.display = '';

    const fragment = document.createDocumentFragment();
    data.forEach(srv => {
      const key = srv.mid.replace(/[^a-zA-Z0-9]/g, '_');
      const existing = oldRows[srv.mid];
      if (existing) {
        // Update existing row
        updateRowData(existing, srv);
        fragment.appendChild(existing);
        delete oldRows[srv.mid];
      } else {
        fragment.appendChild(createServerRow(srv));
      }
      serverRows[srv.mid] = fragment.lastElementChild;
    });

    if (tbody) {
      tbody.innerHTML = '';
      tbody.appendChild(fragment);
    }

    document.querySelector('.refresh-info span').textContent = String(data.length);
    updateStatCards(data);
  }

  function updateRowData(tr, srv) {
    const maxPl = srv.max_players || 0;
    const players = srv.players || 0;
    const pct = maxPl ? Math.round(players / maxPl * 100) : 0;
    const barColor = pct > 80 ? '#f87171' : pct > 50 ? '#fbbf24' : '#34d399';

    const playersEl = tr.querySelector('.srv-players');
    const pctEl = tr.querySelector('.srv-pct');
    const barEl = tr.querySelector('.srv-bar');
    const seenEl = tr.querySelector('.srv-seen');
    const uptimeEl = tr.querySelector('.srv-uptime');

    if (playersEl) { playersEl.textContent = players + ' / ' + maxPl; playersEl.style.color = barColor; }
    if (pctEl) pctEl.textContent = pct + '%';
    if (barEl) { barEl.style.width = Math.min(pct, 100) + '%'; barEl.style.background = barColor; }
    if (seenEl && srv.last_seen) seenEl.textContent = srv.last_seen;
    if (uptimeEl && srv.uptime_start) uptimeEl.textContent = srv.uptime_start;
  }

  function handleServerOnline(srv) {
    if (!srv || !srv.mid) return;
    if (serverRows[srv.mid]) {
      updateRowData(serverRows[srv.mid], srv);
      return;
    }
    if (emptyState) emptyState.style.display = 'none';
    if (tableScroll) tableScroll.style.display = '';
    const tr = createServerRow(srv);
    serverRows[srv.mid] = tr;
    if (tbody) tbody.insertBefore(tr, tbody.firstChild);
    document.querySelector('.refresh-info span').textContent = String(Object.keys(serverRows).length);
  }

  function handleServerOffline(data) {
    if (!data || !data.mid) return;
    const tr = serverRows[data.mid];
    if (tr && tbody) {
      tr.style.opacity = '0.4';
      tr.style.transition = 'opacity .5s';
      setTimeout(() => {
        tr.style.opacity = '0';
        setTimeout(() => {
          tr.remove();
          delete serverRows[data.mid];
          document.querySelector('.refresh-info span').textContent = String(Object.keys(serverRows).length);
          if (!Object.keys(serverRows).length && emptyState) {
            emptyState.style.display = '';
            if (tableScroll) tableScroll.style.display = 'none';
          }
        }, 300);
      }, 2000);
    }
  }

  function handleServerHB(data) {
    if (!data || !data.mid) return;
    const tr = serverRows[data.mid];
    if (tr) updateRowData(tr, data);
  }

  // ═══════════════════════════════════════════════════════════════════════════
  // Player Chart
  // ═══════════════════════════════════════════════════════════════════════════
  const ctx = document.getElementById('playerChart').getContext('2d');

  Chart.defaults.color = '#9ca3af';
  Chart.defaults.borderColor = '#374151';

  const chart = new Chart(ctx, {
    type: 'line',
    data: {
      labels: [],
      datasets: [{
        label: 'Tổng players',
        data: [],
        borderColor: '#6366f1',
        backgroundColor: 'rgba(99,102,241,.12)',
        borderWidth: 2,
        pointRadius: 2,
        pointHoverRadius: 5,
        fill: true,
        tension: 0.35,
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      animation: { duration: 400 },
      plugins: {
        legend: { display: false },
        tooltip: {
          callbacks: {
            title: items => items[0].label,
            label: item => ' ' + item.raw + ' players',
          }
        }
      },
      scales: {
        x: {
          grid: { color: '#1f2937' },
          ticks: { maxTicksLimit: 8, maxRotation: 0, font: { size: 11 } }
        },
        y: {
          grid: { color: '#1f2937' },
          beginAtZero: true,
          ticks: { precision: 0, font: { size: 11 } }
        }
      }
    }
  });

  function fmtTime(ms) {
    const d = new Date(ms);
    return d.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
  }

  function loadChart() {
    fetch('/api/stats')
      .then(r => r.json())
      .then(data => {
        const pts = data.total || [];
        chart.data.labels   = pts.map(p => fmtTime(p[0]));
        chart.data.datasets[0].data = pts.map(p => p[1]);
        chart.update();
        const statusEl = document.getElementById('chartStatus');
        if (pts.length === 0) {
          statusEl.textContent = 'Chưa có dữ liệu';
        } else {
          const last = pts[pts.length - 1];
          statusEl.textContent = pts.length + ' điểm · cập nhật lúc ' + fmtTime(last[0]);
        }
      })
      .catch(() => { document.getElementById('chartStatus').textContent = 'Không tải được dữ liệu'; });
  }

  // ═══════════════════════════════════════════════════════════════════════════
  // Init
  // ═══════════════════════════════════════════════════════════════════════════
  // Pre-populate existing rows from server-render
  const existingRows = tbody ? tbody.querySelectorAll('tr') : [];
  existingRows.forEach(tr => {
    const code = tr.querySelector('code');
    if (code) serverRows[code.textContent] = tr;
  });

  connectWS();
  loadChart();
  // Chart refresh every 80s as fallback
  setInterval(loadChart, 80 * 1000);
</script>
</body>
</html>
