<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>License Portal — Customer Self-Service</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
  <style>
    :root { --bg:#111827; --surface:#1f2937; --border:#374151; --text:#f9fafb; --muted:#9ca3af; --primary:#6366f1; }
    * { box-sizing: border-box; }
    body { background: linear-gradient(135deg, #0f1117 0%, #1a1f3a 100%); color: var(--text);
           font-family: 'Segoe UI', sans-serif; min-height: 100vh; margin: 0;
           display: flex; align-items: center; justify-content: center; padding: 20px; }
    .wrap { width: 100%; max-width: 540px; }
    .header { text-align: center; margin-bottom: 28px; }
    .header i { font-size: 2.8rem; color: var(--primary); }
    .header h1 { font-size: 1.6rem; font-weight: 800; margin: 12px 0 4px; }
    .header p  { color: var(--muted); font-size: .9rem; margin: 0; }
    .card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px;
            padding: 32px; box-shadow: 0 20px 50px rgba(0,0,0,.3); }
    .form-group { margin-bottom: 16px; }
    .form-group label { display: block; font-size: .78rem; font-weight: 600; color: var(--muted);
                        text-transform: uppercase; letter-spacing: .05em; margin-bottom: 6px; }
    .form-group input { width: 100%; background: #161e2e; color: var(--text); border: 1px solid var(--border);
                        border-radius: 8px; padding: 11px 14px; font-size: .9rem; outline: none;
                        font-family: monospace; }
    .form-group input:focus { border-color: var(--primary); }
    .btn-primary { width: 100%; background: var(--primary); color: #fff; border: none;
                   padding: 12px; border-radius: 8px; font-size: .9rem; font-weight: 700; cursor: pointer; }
    .btn-primary:hover { opacity: .85; }
    .flash-danger { background: #7f1d1d; color: #fca5a5; border: 1px solid #991b1b;
                    padding: 12px 14px; border-radius: 8px; font-size: .875rem; margin-bottom: 18px;
                    display: flex; align-items: center; gap: 8px; }
    /* Result view */
    .status-banner { padding: 18px 22px; border-radius: 12px; margin-bottom: 20px;
                     display: flex; align-items: center; gap: 14px; }
    .status-banner i { font-size: 2rem; }
    .status-banner .label { font-size: .78rem; text-transform: uppercase; letter-spacing: .08em; opacity: .8; }
    .status-banner .text  { font-size: 1.1rem; font-weight: 700; }
    .banner-ok      { background: #064e3b; color: #6ee7b7; border: 1px solid #065f46; }
    .banner-warn    { background: #451a03; color: #fbbf24; border: 1px solid #78350f; }
    .banner-danger  { background: #7f1d1d; color: #fca5a5; border: 1px solid #991b1b; }
    .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 18px; }
    .info-item { background: #161e2e; border: 1px solid var(--border); border-radius: 10px; padding: 14px 16px; }
    .info-item .key { font-size: .72rem; color: var(--muted); text-transform: uppercase;
                      letter-spacing: .05em; margin-bottom: 4px; }
    .info-item .val { font-size: .95rem; font-weight: 700; }
    .full-row { grid-column: 1 / -1; }
    .tier-badge { display: inline-block; padding: 3px 10px; border-radius: 999px;
                  font-size: .72rem; font-weight: 700; }
    .pill-online  { background: #064e3b; color: #34d399; padding: 3px 10px; border-radius: 999px;
                    font-size: .78rem; font-weight: 700; }
    .pill-offline { background: #374151; color: #9ca3af; padding: 3px 10px; border-radius: 999px;
                    font-size: .78rem; font-weight: 700; }
    .btn-back { display: block; width: 100%; text-align: center; padding: 12px;
                color: var(--muted); border: 1px solid var(--border); border-radius: 8px;
                background: transparent; font-size: .875rem; cursor: pointer;
                text-decoration: none; margin-top: 12px; }
    .btn-back:hover { background: var(--border); color: var(--text); }
    .footer { text-align: center; margin-top: 22px; color: var(--muted); font-size: .78rem; }
    code { background: #161e2e; color: #a5b4fc; padding: 2px 6px; border-radius: 4px; font-size: .82rem; }
  </style>
</head>
<body>

<div class="wrap">
  <div class="header">
    <i class="bi bi-shield-lock-fill"></i>
    <h1>License Portal</h1>
    <p>Tra cứu trạng thái license của server</p>
  </div>

  <div class="card">

    <% if (error) { %>
      <div class="flash-danger"><i class="bi bi-exclamation-circle"></i><%= error %></div>
    <% } %>

    <% if (!result) { %>
      <!-- Form lookup -->
      <form method="POST" action="/portal">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
          <label>Machine ID</label>
          <input name="mid" placeholder="aa:bb:cc:dd:ee:ff|hostname" required autofocus
                 value="<%= typeof prefill_mid !== 'undefined' ? prefill_mid : '' %>">
        </div>
        <div class="form-group">
          <label>License Key</label>
          <input name="key" placeholder="32 ký tự HEX" maxlength="40">
        </div>
        <button type="submit" class="btn-primary"><i class="bi bi-search me-2"></i>Kiểm tra</button>
      </form>
    <% } else {
         var TIERS = result.TIERS;
         var td = TIERS[result.tier] || TIERS.basic;
         var statusClass, statusText, statusIcon;
         if (result.revoked) {
           statusClass = 'banner-danger'; statusIcon = 'x-circle-fill';
           statusText  = 'License đã bị thu hồi';
         } else if (result.expired) {
           statusClass = 'banner-danger'; statusIcon = 'calendar-x-fill';
           statusText  = 'License đã hết hạn';
         } else if (result.expiry && result.expiry.daysLeft <= 7) {
           statusClass = 'banner-warn'; statusIcon = 'exclamation-triangle-fill';
           statusText  = 'Sắp hết hạn — còn ' + result.expiry.daysLeft + ' ngày';
         } else {
           statusClass = 'banner-ok'; statusIcon = 'check-circle-fill';
           statusText  = 'License hợp lệ';
         }
    %>
      <!-- Result view -->
      <div class="status-banner <%= statusClass %>">
        <i class="bi bi-<%= statusIcon %>"></i>
        <div>
          <div class="label">Trạng thái</div>
          <div class="text"><%= statusText %></div>
        </div>
      </div>

      <div class="info-grid">
        <div class="info-item full-row">
          <div class="key">Machine ID</div>
          <div class="val"><code><%= result.mid %></code></div>
        </div>

        <div class="info-item">
          <div class="key">Gói</div>
          <div class="val">
            <span class="tier-badge" style="background:<%= td.bg %>;color:<%= td.color %>">
              <%= td.label %>
            </span>
          </div>
        </div>

        <div class="info-item">
          <div class="key">Max Players</div>
          <div class="val"><%= result.tier === 'unlimited' ? '∞' : result.max_players %></div>
        </div>

        <div class="info-item">
          <div class="key">Trạng thái server</div>
          <div class="val">
            <% if (result.isOnline) { %>
              <span class="pill-online">● Online · <%= result.players %> players</span>
            <% } else { %>
              <span class="pill-offline">○ Offline</span>
            <% } %>
          </div>
        </div>

        <div class="info-item">
          <div class="key">Peak Players</div>
          <div class="val" style="color:#fbbf24"><%= result.peak_players %></div>
        </div>

        <% if (result.expiry) { %>
        <div class="info-item full-row">
          <div class="key">Ngày hết hạn</div>
          <div class="val">
            <%= result.expiry.date %>
            <% if (!result.expired) { %>
              <span style="font-size:.78rem;color:var(--muted);font-weight:400">
                — còn <%= result.expiry.daysLeft %> ngày
              </span>
            <% } %>
          </div>
        </div>
        <% } %>

        <div class="info-item full-row">
          <div class="key">Ngày cấp</div>
          <div class="val" style="font-size:.85rem;color:var(--muted)"><%= result.added %></div>
        </div>

        <% if (result.geo) { %>
        <div class="info-item full-row">
          <div class="key">Vị trí server</div>
          <div class="val" style="font-size:.9rem">
            <i class="bi bi-geo-alt-fill" style="color:#34d399"></i>
            <%= result.geo.city || '?' %>, <%= result.geo.country || '?' %>
            <% if (result.geo.code) { %>
              <span style="color:var(--muted);font-size:.78rem">(<%= result.geo.code %>)</span>
            <% } %>
          </div>
        </div>
        <% } %>

        <% if (result.note) { %>
        <div class="info-item full-row">
          <div class="key">Ghi chú</div>
          <div class="val" style="font-size:.85rem;font-weight:400;color:var(--muted)">
            <%= result.note %>
          </div>
        </div>
        <% } %>
      </div>

      <a href="/portal" class="btn-back"><i class="bi bi-arrow-left me-1"></i>Tra cứu license khác</a>
    <% } %>

  </div>

  <div class="footer">
    <i class="bi bi-shield-check me-1"></i>
    Nếu cần hỗ trợ, vui lòng liên hệ admin với Machine ID của bạn.
  </div>
</div>

</body>
</html>
